@model Training_Platform.ViewModels.ReviewWithRelatedVM

@{
    ViewData["Title"] = "Manage Reviews";
}

<div class="card shadow-sm mb-3">

    <!-- Header: Search & Title -->
    <div class="card-header bg-white py-3">
        <div class="row align-items-center">
            <div class="col">
                <h5 class="mb-0">All Reviews</h5>
            </div>

            <div class="col-auto">
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input name="query"
                               value="@Model.Query"
                               class="form-control form-control-sm"
                               placeholder="Search reviews..." />
                        <button class="btn btn-primary btn-sm" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Body: Reviews Table -->
    <div class="card-body p-0">
        @if (!Model.Reviews.Any())
        {
            <div class="alert alert-warning text-center m-3">
                No reviews found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Course</th>
                            <th>User</th>
                            <th>Rating</th>
                            <th>Comment</th>
                            <th>Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Reviews)
                        {
                            <tr>
                                <td>
                                    <strong>@(item.Course?.Title ?? "N/A")</strong>
                                </td>
                                <td>
                                    @(item.User?.UserName ?? "N/A")
                                </td>
                                <td>
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.Rating)
                                        {
                                            <i class="fas fa-star text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="far fa-star text-secondary"></i>
                                        }
                                    }
                                    <span class="ms-1 fw-bold">(@item.Rating)</span>
                                </td>
                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Comment)
                                        ? "-"
                                        : item.Comment.Length > 60
                                            ? item.Comment[..60] + "..."
                                            : item.Comment)
                                </td>
                                <td>
                                    @item.CreatedAt.ToString("dd MMM yyyy")
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm text-white me-1"
                                       title="View Details">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <button class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteReviewModal"
                                            data-id="@item.Id"
                                            title="Delete Review">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Footer: Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3">
            <nav>
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-query="@Model.Query">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Single Delete Modal Wrapper -->
<div class="modal fade" id="deleteReviewModal" tabindex="-1" aria-labelledby="deleteReviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteReviewModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this review? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteReviewId" name="id" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
                const reviewModal = document.getElementById('deleteReviewModal');
        if (reviewModal) {
                    reviewModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const reviewId = button.getAttribute('data-id');
                        document.getElementById('deleteReviewId').value = reviewId;
            });
                }
    </script>
}