@model Training_Platform.Models.UserProgress

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            User Progress Details
        </h5>

        <a asp-action="Index"
           class="btn btn-secondary btn-sm">

            <i class="fas fa-arrow-left me-1"></i>
            Back

        </a>

    </div>


    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <h6>Trainee</h6>

                <p>
                    @(Model.User?.UserName ?? "Unknown User")
                </p>

            </div>


            <div class="col-md-6">

                <h6>Lesson</h6>

                <p>
                    @(Model.Lesson?.Title ?? "Unknown Lesson")
                </p>

            </div>

        </div>


        <hr />


        <div class="row">

            <div class="col-md-6">

                <h6>Course</h6>

                <p>
                    @(Model.Lesson?.Course?.Title
                        ?? "Unknown Course")
                </p>

            </div>


            <div class="col-md-6">

                <h6>Status</h6>

                @if (Model.IsCompleted)
                {
                    <span class="badge bg-success">
                        Completed
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        In Progress
                    </span>
                }

            </div>

        </div>


        <div class="mt-4">

            <h6>Completed At</h6>

            <p>
                @(Model.CompletedAt.HasValue
                    ? Model.CompletedAt.Value
                        .ToString("dd/MM/yyyy HH:mm")
                    : "Not completed yet")
            </p>

        </div>


        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-edit me-1"></i>
                Edit

            </a>

        </div>

    </div>

</div>