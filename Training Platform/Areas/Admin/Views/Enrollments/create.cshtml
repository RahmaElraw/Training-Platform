@model Training_Platform.ViewModels.EnrollmentVM

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">Create Enrollment</h5>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row">

                <!-- User -->
                <div class="col-md-6 mb-3">

                    <label asp-for="UserId" class="form-label">
                        Trainee
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="UserId"
                            asp-items="ViewBag.Users"
                            class="form-select">

                        <option value="">
                            -- Select Trainee --
                        </option>

                    </select>

                    <span asp-validation-for="UserId"
                          class="text-danger">
                    </span>

                </div>

                <!-- Course -->
                <div class="col-md-6 mb-3">

                    <label asp-for="CourseId" class="form-label">
                        Course
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">

                        <option value="">
                            -- Select Course --
                        </option>

                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    Create Enrollment

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}