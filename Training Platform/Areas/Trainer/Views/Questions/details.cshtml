@using Training_Platform.Models
@model Question

@{
    ViewData["Title"] = Localizer["QuestionDetails"].Value;
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                @Localizer["QuestionDetails"]
            </h2>

            <p class="text-muted mb-0">
                @Localizer["ViewQuestionInfo"]
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                <i class="bi bi-pencil"></i>
                @Localizer["Edit"]
            </a>

            <a asp-action="Index"
               asp-route-quizId="@Model.QuizId"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                @Localizer["BackToQuestions"]
            </a>

        </div>

    </div>

    <!-- Question Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                @Localizer["QuestionInformation"]
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-8">

                    <h4 class="fw-bold">
                        @Model.QuestionText
                    </h4>

                </div>

                <div class="col-md-4">

                    <div class="mb-3">

                        <strong>@Localizer["Quiz"]:</strong>

                        <div>
                            @(Model.Quiz?.Title ?? Localizer["NA"].Value)
                        </div>

                    </div>

                    <div class="mb-3">

                        <strong>@Localizer["Type"]:</strong>

                        <div class="mt-1">

                            @if (Model.QuestionType ==
                                QuestionType.MultipleChoice)
                            {
                                <span class="badge bg-primary">
                                    @Localizer["MultipleChoice"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info">
                                    @Localizer["TrueFalse"]
                                </span>
                            }

                        </div>

                    </div>

                    <div>

                        <strong>@Localizer["Mark"]:</strong>

                        <div class="mt-1">

                            <span class="badge bg-secondary">
                                @Model.Mark
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Options -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                @Localizer["AnswerOptions"]
            </h5>

        </div>

        <div class="card-body">

            @if (Model.QuestionOptions != null &&
                 Model.QuestionOptions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>#</th>
                                <th>@Localizer["Option"]</th>
                                <th>@Localizer["CorrectAnswer"]</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var option in Model.QuestionOptions)
                            {
                                <tr>

                                    <td>
                                        @counter
                                    </td>

                                    <td>
                                        @option.OptionText
                                    </td>

                                    <td>

                                        @if (option.IsCorrect)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-lg"></i>
                                                @Localizer["Correct"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @Localizer["Incorrect"]
                                            </span>
                                        }

                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-list-ul fs-2 text-muted"></i>

                    <p class="text-muted mt-2 mb-0">
                        @Localizer["NoOptionsFound"]
                    </p>

                </div>
            }

        </div>

    </div>

</div>