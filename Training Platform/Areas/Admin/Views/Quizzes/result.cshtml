@model Training_Platform.ViewModels.QuizResultViewModel

<h2>Quiz Result</h2>

<h3>@Model.QuizTitle</h3>

<div>
    <strong>Score:</strong>
    @Model.Score%
</div>

<div>
    <strong>Status:</strong>

    @if (Model.IsPassed)
    {
        <span>Passed</span>
    }
    else
    {
        <span>Failed</span>
    }
</div>

<div>
    <strong>Submitted At:</strong>
    @Model.SubmittedAt
</div>

<br />

<a asp-controller="Quiz"
   asp-action="MyResults">
    My Results
</a>