@model Training_Platform.ViewModels.Trainee.LessonDetailsVM

@{
    ViewData["Title"] = Model.Lesson.Title;

    // Process Video URL to ensure YouTube links work inside an iframe
    var videoUrl = Model.Lesson.VideoUrl ?? string.Empty;
    if (videoUrl.Contains("watch?v="))
    {
        videoUrl = videoUrl.Replace("watch?v=", "embed/");
    }
    else if (videoUrl.Contains("youtu.be/"))
    {
        videoUrl = videoUrl.Replace("youtu.be/", "www.youtube.com/embed/");
    }
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="mb-4">
        <a asp-action="Index"
           asp-route-courseId="@Model.Course.Id"
           class="text-decoration-none">
            <i class="fas fa-arrow-left me-1"></i>
            Back to Lessons
        </a>

        <h3 class="mt-3 mb-1">
            @Model.Lesson.OrderNumber. @Model.Lesson.Title
        </h3>

        <p class="text-600 mb-0">
            @Model.Course.Title
        </p>
    </div>

    <div class="row g-4">

        <!-- Main Lesson -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">

                    <!-- Video Container -->
                    <div class="ratio ratio-16x9 mb-4 bg-black rounded">
                        @if (!string.IsNullOrWhiteSpace(videoUrl) &&
                             (videoUrl.EndsWith(".mp4") || videoUrl.EndsWith(".webm")))
                        {
                            <!-- Direct MP4 / WebM File -->
                            <video controls class="w-100 h-100">
                                <source src="@videoUrl" type="video/mp4" />
                                Your browser does not support the video tag.
                            </video>
                        }
                        else if (!string.IsNullOrWhiteSpace(videoUrl))
                        {
                            <!-- Embedded Iframe (YouTube / Vimeo / External) -->
                            <iframe src="@videoUrl"
                                    title="@Model.Lesson.Title"
                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                    allowfullscreen>
                            </iframe>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center text-white">
                                <i class="fas fa-video-slash me-2"></i> No video available for this lesson.
                            </div>
                        }
                    </div>

                    <!-- Lesson Info -->
                    <h4 class="mb-3">
                        @Model.Lesson.Title
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(Model.Lesson.Description))
                    {
                        <p class="text-700">
                            @Model.Lesson.Description
                        </p>
                    }

                    <hr class="my-4" />

                    <!-- Completion Status & Action -->
                    @if (Model.IsCompleted)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-0">
                            <i class="fas fa-check-circle fs-4 me-2"></i>
                            <div>
                                <strong>Completed!</strong> You have finished this lesson.
                            </div>
                        </div>
                    }
                    else
                    {
                        <form asp-action="Complete" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check me-1"></i> Mark as Completed
                            </button>
                        </form>
                    }

                </div>
            </div>
        </div>

        <!-- Sidebar / Course Materials & Navigation -->
        <div class="col-lg-4">

            <!-- Materials Card -->
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        Course Materials
                    </h5>
                </div>

                <div class="card-body">
                    @if (Model.Lesson.CourseMaterials != null && Model.Lesson.CourseMaterials.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var material in Model.Lesson.CourseMaterials)
                            {
                                <a href="@material.Url"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="list-group-item list-group-item-action d-flex align-items-center px-2">
                                    <i class="fas fa-file-alt text-primary me-3 fs-5"></i>
                                    <span class="text-truncate">@material.Title</span>
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                            <p class="mb-0">No materials available for this lesson.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Lesson Navigation Card -->
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        @if (Model.PreviousLessonId.HasValue)
                        {
                            <a asp-action="Details"
                               asp-route-id="@Model.PreviousLessonId"
                               class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i> Previous
                            </a>
                        }
                        else
                        {
                            <div></div>
                        }

                        @if (Model.NextLessonId.HasValue)
                        {
                            <a asp-action="Details"
                               asp-route-id="@Model.NextLessonId"
                               class="btn btn-primary">
                                Next <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>