@model Training_Platform.ViewModels.ResendEmailConfirmationVM

@{
    ViewData["Title"] = "Resend Confirmation";
    Layout = "_AuthLayout";
}

<h2>Resend Confirmation</h2>
<p class="subtitle">Enter your email or username to resend the confirmation link</p>

<form asp-action="ResendEmailConfirmation" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-4">
        <label asp-for="EmailOrUserName" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <input asp-for="EmailOrUserName" class="form-control" placeholder="Email or Username" />
        </div>
        <span asp-validation-for="EmailOrUserName" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <input type="submit" value="Resend Confirmation" class="btn btn-primary btn-lg" />
    </div>

    <div class="switch-link">
        Remembered your password? <a asp-action="Login">Login</a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />

}