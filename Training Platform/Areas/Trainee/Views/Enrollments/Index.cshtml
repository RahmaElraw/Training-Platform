@model IEnumerable<Training_Platform.ViewModels.Trainee.EnrollmentItemVM>

@{
    ViewData["Title"] = "My Enrolled Courses";
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-dark fw-bold">My Enrolled Courses</h4>
            <p class="text-secondary small mb-0">
                Track your ongoing courses, access lessons, and manage course evaluations.
            </p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-search me-1"></i> Browse More Courses
        </a>
    </div>

    @if (Model.Any())
    {
        <!-- 4 columns on XL, 3 on LG, 2 on MD/SM -->
        <div class="row g-3">
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0">

                        <!-- Course Image -->
                        @if (!string.IsNullOrWhiteSpace(item.CourseThumbnail))
                        {
                            <img src="@item.CourseThumbnail"
                                 class="card-img-top"
                                 alt="@item.CourseTitle"
                                 style="height: 140px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 140px;">
                                <i class="fas fa-graduation-cap fa-2x text-secondary"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-3">

                            <!-- Status & Level Badges -->
                            <div class="d-flex justify-content-between align-items-center mb-2 gap-1">
                                <span class="badge bg-primary text-truncate" style="max-width: 80px;">@item.Level</span>

                                @if (item.IsCompleted)
                                {
                                    <span class="badge bg-success flex-shrink-0">
                                        <i class="fas fa-check-circle me-1"></i> Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark flex-shrink-0">
                                        <i class="fas fa-spinner me-1"></i> In Progress
                                    </span>
                                }
                            </div>

                            <!-- Course Title -->
                            <h6 class="card-title text-dark fw-bold mb-2 text-truncate" title="@item.CourseTitle">
                                @item.CourseTitle
                            </h6>

                            <!-- Meta Info -->
                            <div class="text-secondary small mb-3">
                                <div class="mb-1 text-truncate">
                                    <i class="fas fa-layer-group me-1 text-primary"></i>
                                    @item.TotalLessons Lessons
                                </div>
                                <div class="text-truncate">
                                    <i class="fas fa-calendar-alt me-1 text-primary"></i>
                                    Enrolled: @item.EnrollmentDate.ToString("MMM dd, yyyy")
                                </div>
                            </div>

                            <!-- Action Buttons -->
                            <div class="mt-auto d-flex flex-column gap-1">

                                <!-- View Lessons -->
                                <a asp-controller="Lessons"
                                   asp-action="Index"
                                   asp-route-courseId="@item.CourseId"
                                   class="btn btn-primary btn-sm w-100">
                                    <i class="fas fa-play-circle me-1"></i> Continue Learning
                                </a>

                                <div class="d-flex gap-1">
                                    <!-- Course Evaluation (Rate / Edit Review) -->
                                    @if (item.HasReviewed)
                                    {
                                        <a asp-controller="Reviews"
                                           asp-action="Edit"
                                           asp-route-id="@item.ReviewId"
                                           class="btn btn-outline-warning btn-sm w-100 text-dark text-truncate px-1">
                                            <i class="fas fa-star text-warning me-1"></i> Edit Review
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Reviews"
                                           asp-action="Create"
                                           asp-route-courseId="@item.CourseId"
                                           class="btn btn-warning btn-sm w-100 text-dark text-truncate px-1">
                                            <i class="far fa-star me-1"></i> Rate Course
                                        </a>
                                    }

                                    <!-- Direct Unenroll Button -->
                                    <form asp-action="Unenroll"
                                          asp-route-id="@item.EnrollmentId"
                                          method="post"
                                          class="w-100"
                                          onsubmit="return confirm('Are you sure you want to unenroll from @item.CourseTitle? Your progress will be lost.');">
                                        <button type="submit" class="btn btn-outline-dark btn-sm w-100 text-truncate px-1">
                                            <i class="fas fa-user-minus me-1"></i> Unenroll
                                        </button>
                                    </form>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <i class="fas fa-book-reader fa-2x text-secondary mb-2"></i>
                <h6 class="text-dark fw-bold">No Enrolled Courses</h6>
                <p class="text-secondary small mb-3">
                    You haven't enrolled in any courses yet. Start learning today!
                </p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-sm">
                    Explore Available Courses
                </a>
            </div>
        </div>
    }
</div>