@using Training_Platform.Models
@model Course

@{
    ViewData["Title"] = "Course Details";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">@Model.Title</h2>

            <p class="text-muted mb-0">
                Manage the lessons and quizzes of this course.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Courses
        </a>

    </div>


    <!-- Course Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                <i class="bi bi-info-circle me-2"></i>
                Course Information
            </h5>
        </div>

        <div class="card-body">

            <div class="row">

                <!-- Description -->
                <div class="col-lg-8">

                    <h4 class="fw-bold mb-3">
                        @Model.Title
                    </h4>

                    <p class="text-muted mb-0">
                        @Model.Description
                    </p>

                </div>


                <!-- Course Details -->
                <div class="col-lg-4">

                    <div class="mb-3">
                        <strong>Category:</strong>
                        <span class="ms-1">
                            @(Model.Category?.Name ?? "N/A")
                        </span>
                    </div>

                    <div class="mb-3">
                        <strong>Level:</strong>

                        <span class="badge bg-secondary ms-1">
                            @Model.Level
                        </span>
                    </div>

                    <div class="mb-3">
                        <strong>Duration:</strong>

                        <span class="ms-1">
                            @Model.DurationInHours hours
                        </span>
                    </div>

                    <div>
                        <strong>Status:</strong>

                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success ms-1">
                                Published
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark ms-1">
                                Draft
                            </span>
                        }
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Lessons & Quizzes -->
    <div class="row">


        <!-- ================= LESSONS ================= -->

        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm h-100">

                <!-- Header -->
                <div class="card-header bg-white
                    d-flex justify-content-between
                    align-items-center">

                    <h5 class="mb-0">
                        <i class="bi bi-book-open me-2"></i>
                        Lessons
                    </h5>

                    <a asp-area="Trainer"
                       asp-controller="Lessons"
                       asp-action="Create"
                       asp-route-courseId="@Model.Id"
                       class="btn btn-sm btn-primary"
                       title="Add Lesson">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Lesson

                    </a>

                </div>


                <!-- Body -->
                <div class="card-body">

                    @if (Model.Lessons != null && Model.Lessons.Any())
                    {
                        <div class="list-group">

                            @foreach (var lesson in Model.Lessons
                                .OrderBy(l => l.OrderNumber)
                                .ThenBy(l => l.Id))
                            {
                                <div class="list-group-item">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                        <!-- Lesson Info -->
                                        <div class="me-2">

                                            <div class="fw-semibold">

                                                <span class="badge bg-secondary me-2">
                                                    @lesson.OrderNumber
                                                </span>

                                                @lesson.Title

                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(lesson.Description))
                                            {
                                                <small class="text-muted">
                                                    @(lesson.Description.Length > 70
                                                        ? lesson.Description.Substring(0, 70) + "..."
                                                        : lesson.Description)
                                                </small>
                                            }

                                        </div>


                                        <!-- Actions -->
                                        <div class="d-flex gap-1 flex-shrink-0">

                                            <!-- Details -->
                                            <a asp-area="Trainer"
                                               asp-controller="Lessons"
                                               asp-action="Details"
                                               asp-route-id="@lesson.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Lesson Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-area="Trainer"
                                               asp-controller="Lessons"
                                               asp-action="Edit"
                                               asp-route-id="@lesson.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Lesson">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-area="Trainer"
                                                  asp-controller="Lessons"
                                                  asp-action="Delete"
                                                  asp-route-id="@lesson.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this lesson? Related materials and progress will also be deleted.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete Lesson">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-journal-x fs-1 text-muted"></i>

                            <h6 class="mt-3">
                                No Lessons Yet
                            </h6>

                            <p class="text-muted mb-3">
                                This course doesn't have any lessons yet.
                            </p>

                            <a asp-area="Trainer"
                               asp-controller="Lessons"
                               asp-action="Create"
                               asp-route-courseId="@Model.Id"
                               class="btn btn-primary">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add First Lesson

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>



        <!-- ================= QUIZZES ================= -->

        <div class="col-lg-6 mb-4">

            <div class="card shadow-sm h-100">

                <!-- Header -->
                <div class="card-header bg-white
                    d-flex justify-content-between
                    align-items-center">

                    <h5 class="mb-0">
                        <i class="bi bi-clipboard-list me-2"></i>
                        Quizzes
                    </h5>

                    <a asp-area="Trainer"
                       asp-controller="Quizzes"
                       asp-action="Create"
                       asp-route-courseId="@Model.Id"
                       class="btn btn-sm btn-success"
                       title="Add Quiz">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Quiz

                    </a>

                </div>


                <!-- Body -->
                <div class="card-body">

                    @if (Model.Quizzes != null && Model.Quizzes.Any())
                    {
                        <div class="list-group">

                            @foreach (var quiz in Model.Quizzes
                                .OrderBy(q => q.Id))
                            {
                                <div class="list-group-item">

                                    <div class="d-flex
                                        justify-content-between
                                        align-items-center">

                                        <!-- Quiz Info -->
                                        <div class="me-2">

                                            <div class="fw-semibold">

                                                <i class="bi bi-clipboard-list me-2"></i>

                                                @quiz.Title

                                            </div>

                                            <small class="text-muted">
                                                Passing Score:
                                                @quiz.PassingScore%
                                                &nbsp; | &nbsp;
                                                Time:
                                                @quiz.TimeLimit min
                                            </small>

                                        </div>


                                        <!-- Actions -->
                                        <div class="d-flex gap-1 flex-shrink-0">

                                            <!-- Details -->
                                            <a asp-area="Trainer"
                                               asp-controller="Quizzes"
                                               asp-action="Details"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Quiz Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-area="Trainer"
                                               asp-controller="Quizzes"
                                               asp-action="Edit"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Quiz">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-area="Trainer"
                                                  asp-controller="Quizzes"
                                                  asp-action="Delete"
                                                  asp-route-id="@quiz.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this quiz? All related questions and options will also be deleted.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete Quiz">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">

                            <i class="bi bi-clipboard-x fs-1 text-muted"></i>

                            <h6 class="mt-3">
                                No Quizzes Yet
                            </h6>

                            <p class="text-muted mb-3">
                                This course doesn't have any quizzes yet.
                            </p>

                            <a asp-area="Trainer"
                               asp-controller="Quizzes"
                               asp-action="Create"
                               asp-route-courseId="@Model.Id"
                               class="btn btn-success">

                                <i class="bi bi-plus-lg me-1"></i>
                                Add First Quiz

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- Progress -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-graph-up-arrow me-2"></i>
                Trainee Progress
            </h5>

        </div>

        <div class="card-body">

            <p class="text-muted">
                View the progress of trainees enrolled in this course.
            </p>

            <a asp-area="Trainer"
               asp-controller="Progress"
               asp-action="Index"
               class="btn btn-outline-primary">

                <i class="bi bi-bar-chart-line me-1"></i>
                View Progress

            </a>

        </div>

    </div>

</div>