@model QuizResultViewModel

@{
    ViewData["Title"] = "Quiz Result";
}

<div class="container mt-5">

    <div class="card">
        <div class="card-body text-center">

            <h2>Quiz Result</h2>

            <h4 class="mt-3">
                @Model.QuizTitle
            </h4>

            <h1 class="mt-4">
                @Model.Score%
            </h1>

            @if (Model.IsPassed)
            {
                <span class="badge bg-success">
                    Passed
                </span>
            }
            else
            {
                <span class="badge bg-danger">
                    Failed
                </span>
            }

            <p class="text-muted mt-3">
                @Model.SubmittedAt.ToLocalTime()
            </p>

            <a asp-action="Results"
               class="btn btn-primary mt-3">
                My Quiz Results
            </a>

        </div>
    </div>

</div>