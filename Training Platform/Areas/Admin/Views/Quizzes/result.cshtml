@model Training_Platform.ViewModels.QuizResultViewModel

<h2>@Localizer["QuizResult"]</h2>

<h3>@Model.QuizTitle</h3>

<div>
    <strong>@Localizer["Score"]:</strong>
    @Model.Score%
</div>

<div>
    <strong>@Localizer["Status"]:</strong>

    @if (Model.IsPassed)
    {
        <span>@Localizer["Passed"]</span>
    }
    else
    {
        <span>@Localizer["Failed"]</span>
    }
</div>

<div>
    <strong>@Localizer["SubmittedAt"]:</strong>
    @Model.SubmittedAt
</div>

<br />

<a asp-controller="Quiz"
   asp-action="MyResults">
    @Localizer["MyResults"]
</a>