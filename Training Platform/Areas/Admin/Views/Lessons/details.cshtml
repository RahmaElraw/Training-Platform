@model Training_Platform.Models.Lesson

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="fas fa-book-open me-1"></i>
            @Localizer["LessonDetails"]
        </h5>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
                <i class="fas fa-edit me-1"></i>
                @Localizer["EditLesson"]
            </a>

            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left me-1"></i>
                @Localizer["Back"]
            </a>
        </div>
    </div>

    <div class="card-body">
        <!-- Lesson Information -->
        <h3 class="mb-2">@Model.Title</h3>

        <p class="text-muted">
            @(string.IsNullOrWhiteSpace(Model.Description) ? Localizer["NoDescription"].Value : Model.Description)
        </p>

        <div class="row mt-4">
            <div class="col-md-6">
                <p>
                    <strong>
                        <i class="fas fa-book me-1"></i>
                        @Localizer["Course"]:
                    </strong>
                    @(Model.Course?.Title ?? Localizer["NoCourse"].Value)
                </p>

                <p>
                    <strong>
                        <i class="fas fa-sort-numeric-up me-1"></i>
                        @Localizer["OrderNumber"]:
                    </strong>
                    @Model.OrderNumber
                </p>
            </div>

            <div class="col-md-6">
                <p>
                    <strong>
                        <i class="fas fa-file-alt me-1"></i>
                        @Localizer["Materials"]:
                    </strong>
                    <span class="badge bg-secondary">
                        @Model.CourseMaterials.Count
                    </span>
                </p>

                <p>
                    <strong>
                        <i class="fas fa-users me-1"></i>
                        @Localizer["ProgressRecords"]:
                    </strong>
                    <span class="badge bg-secondary">
                        @Model.UserProgresses.Count
                    </span>
                </p>
            </div>
        </div>

        <!-- Video -->
        <div class="mt-4">
            <h5 class="mb-2">
                <i class="fas fa-video me-1"></i>
                @Localizer["LessonVideo"]
            </h5>

            @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
            {
                <a href="@Model.VideoUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    <i class="fas fa-play me-1"></i>
                    @Localizer["WatchVideo"]
                </a>
            }
            else
            {
                <div class="alert alert-secondary mb-0">
                    <i class="fas fa-info-circle me-1"></i>
                    @Localizer["NoVideoAvailable"]
                </div>
            }
        </div>

        <hr class="my-4" />

        <!-- Materials Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">
                <i class="fas fa-file-alt me-1"></i>
                @Localizer["CourseMaterials"]
            </h5>

            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
                <i class="fas fa-plus me-1"></i>
                @Localizer["AddMaterial"]
            </button>
        </div>

        <!-- Materials List -->
        @if (Model.CourseMaterials != null && Model.CourseMaterials.Any())
        {
            <div class="list-group">
                @foreach (var material in Model.CourseMaterials)
                {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="me-3">
                                <h6 class="mb-1">@material.Title</h6>
                                <a href="@material.Url" target="_blank" rel="noopener noreferrer" class="text-primary text-break">
                                    <i class="fas fa-external-link-alt me-1"></i>
                                    @Localizer["OpenMaterial"]
                                </a>
                            </div>

                            <div class="d-flex gap-2 flex-shrink-0">
                                <a asp-action="EditMaterial" asp-route-id="@material.Id" class="btn btn-sm btn-primary">
                                    <i class="fas fa-edit me-1"></i>
                                    @Localizer["Edit"]
                                </a>

                                <form asp-action="DeleteMaterial" asp-route-id="@material.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this material?');">
                                        <i class="fas fa-trash me-1"></i>
                                        @Localizer["Delete"]
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                <i class="fas fa-info-circle me-1"></i>
                @Localizer["NoCourseMaterialsYet"]
            </div>
        }
    </div>
</div>

<!-- Add Material Modal -->
<div class="modal fade" id="addMaterialModal" tabindex="-1" aria-labelledby="addMaterialModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addMaterialModalLabel">
                    <i class="fas fa-plus-circle me-1"></i>
                    @Localizer["AddCourseMaterial"]
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="AddMaterial" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="LessonId" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label">
                            @Localizer["Title"]
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="Title" class="form-control" maxlength="100" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            @Localizer["Url"]
                            <span class="text-danger">*</span>
                        </label>
                        <input type="url" name="Url" class="form-control" placeholder="https://example.com" required />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        @Localizer["Cancel"]
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-plus me-1"></i>
                        @Localizer["AddMaterial"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Toast Notifications -->
@if (TempData["Success"] != null)
{
    <script>
        toastr.success('@Html.Raw(TempData["Success"])');
    </script>
}

@if (TempData["Error"] != null)
{
    <script>
        toastr.error('@Html.Raw(TempData["Error"])');
    </script>
}