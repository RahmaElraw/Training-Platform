@using Training_Platform.Models
@model Training_Platform.ViewModels.QuestionWithRelatedVM

<div class="card mb-4 shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            All Questions
        </h5>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fas fa-plus me-1"></i>
            Add Question

        </a>

    </div>


    <div class="card-body">

        <!-- Search -->
        <form asp-action="Index"
              method="get">

            <div class="input-group">

                <input type="text"
                       name="query"
                       value="@Model.Query"
                       class="form-control"
                       placeholder="Search question or quiz..." />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-search me-1"></i>
                    Search

                </button>

                @if (!string.IsNullOrWhiteSpace(Model.Query))
                {
                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="fas fa-times me-1"></i>
                        Clear

                    </a>
                }

            </div>

        </form>

    </div>

</div>


<!-- TempData Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="fas fa-check-circle me-1"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="fas fa-exclamation-circle me-1"></i>

        @TempData["Error"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- Questions -->
@if (!Model.Questions.Any())
{
    <div class="alert alert-warning">

        <i class="fas fa-info-circle me-1"></i>

        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <span>
                No questions found matching
                "<strong>@Model.Query</strong>".
            </span>
        }
        else
        {
            <span>
                No questions found.
            </span>
        }

    </div>
}
else
{
    @foreach (var item in Model.Questions)
    {
        <article class="card mb-3 shadow-sm">

            <div class="card-body">

                <div class="row">

                    <!-- Question Information -->

                    <div class="col-md-9">

                        <h5 class="mb-3">
                            @item.QuestionText
                        </h5>


                        <!-- Quiz -->

                        <p class="text-muted mb-3">

                            <strong>
                                <i class="fas fa-book me-1"></i>
                                Quiz:
                            </strong>

                            @(item.Quiz?.Title ?? "No Quiz")

                        </p>


                        <!-- Question Data -->

                        <div class="d-flex flex-wrap gap-4">

                            <!-- Mark -->

                            <span>

                                <strong>
                                    Mark:
                                </strong>

                                @item.Mark

                            </span>


                            <!-- Question Type -->

                            <span>

                                <strong>
                                    Type:
                                </strong>

                                @if (item.QuestionType ==
                                    QuestionType.MultipleChoice)
                                {
                                    <span class="badge bg-primary">

                                        <i class="fas fa-list me-1"></i>
                                        Multiple Choice

                                    </span>
                                }
                                else if (item.QuestionType ==
                                         QuestionType.TrueFalse)
                                {
                                    <span class="badge bg-info">

                                        <i class="fas fa-check-circle me-1"></i>
                                        True / False

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">

                                        @item.QuestionType

                                    </span>
                                }

                            </span>


                            <!-- Options -->

                            <span>

                                <strong>
                                    Options:
                                </strong>

                                <span class="badge bg-secondary">
                                    @item.QuestionOptions.Count
                                </span>

                            </span>

                        </div>

                    </div>


                    <!-- Actions -->

                    <div class="col-md-3 mt-3 mt-md-0">

                        <div class="d-grid gap-2">

                            <!-- Details -->

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info text-white">

                                <i class="fas fa-eye me-1"></i>
                                Details

                            </a>


                            <!-- Edit -->

                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary">

                                <i class="fas fa-edit me-1"></i>
                                Edit

                            </a>


                            <!-- Delete -->

                            <form asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-danger w-100"
                                        onclick="return confirm('Are you sure you want to delete this question?');">

                                    <i class="fas fa-trash-alt me-1"></i>
                                    Delete

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </article>
    }
}


<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Questions pagination">

        <ul class="pagination justify-content-center">

            <!-- Previous -->

            <li class="page-item
                @(Model.CurrentPage <= 1 ? "disabled" : "")">

                @if (Model.CurrentPage > 1)
                {
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-query="@Model.Query">

                        <i class="fas fa-chevron-left"></i>
                        Previous

                    </a>
                }
                else
                {
                    <span class="page-link">

                        <i class="fas fa-chevron-left"></i>
                        Previous

                    </span>
                }

            </li>


            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item
                    @(i == Model.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-query="@Model.Query">

                        @i

                    </a>

                </li>
            }


            <!-- Next -->

            <li class="page-item
                @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-query="@Model.Query">

                        Next
                        <i class="fas fa-chevron-right"></i>

                    </a>
                }
                else
                {
                    <span class="page-link">

                        Next
                        <i class="fas fa-chevron-right"></i>

                    </span>
                }

            </li>

        </ul>

    </nav>
}