@model Training_Platform.ViewModels.CertificateWithRelatedVM

@{
    ViewData["Title"] = Localizer["CertificatesManagement"];
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="fas fa-certificate text-primary me-2"></i>@Localizer["CourseCompletionCertificates"]
        </h5>
    </div>

    <div class="card-body">
        <!-- Search Filter -->
        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-search text-muted"></i></span>
                    <input asp-for="Query"
                           name="query"
                           class="form-control"
                           placeholder="@Localizer["SearchByCertificateUserOrCourse"]" />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    @Localizer["Search"]
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">@Localizer["Clear"]</a>
                </div>
            }
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["CertificateNo"]</th>
                        <th>@Localizer["User"]</th>
                        <th>@Localizer["Course"]</th>
                        <th>@Localizer["IssueDate"]</th>
                        <th>@Localizer["Status"]</th>
                        <th width="220" class="text-center">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Certificates.Any())
                    {
                        @foreach (var item in Model.Certificates)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.CertificateNumber</td>
                                <td>
                                    <div>@(item.User?.UserName ?? "N/A")</div>
                                    <small class="text-muted">@(item.User?.Email ?? "")</small>
                                </td>
                                <td>@(item.Course?.Title ?? "N/A")</td>
                                <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.CertificateUrl))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">
                                            <i class="fas fa-check-circle me-1"></i> @Localizer["LinkAdded"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i> @Localizer["PendingLink"]
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-info"
                                           title="@Localizer["ViewDetails"]">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn @(string.IsNullOrWhiteSpace(item.CertificateUrl) ? "btn-warning" : "btn-outline-primary")"
                                           title="@Localizer["ManageCertificateLink"]">
                                            <i class="fas fa-link me-1"></i>
                                            @(string.IsNullOrWhiteSpace(item.CertificateUrl) ? Localizer["AddLink"] : Localizer["EditLink"])
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-outline-danger"
                                                    title="@Localizer["Delete"]"
                                                    onclick="return confirm('@Localizer["ConfirmDeleteCertificate"]');">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                                @Localizer["NoCertificatesFound"]
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-query="@Model.Query">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>