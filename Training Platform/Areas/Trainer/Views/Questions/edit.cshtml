@using Training_Platform.Models
@model Training_Platform.ViewModels.QuestionVM

@{
    ViewData["Title"] = Localizer["EditQuestion"].Value;

    var quiz = ViewBag.Quiz as Quiz;
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">

        <h2 class="fw-bold">
            @Localizer["EditQuestion"]
        </h2>

        <p class="text-muted mb-0">
            @Localizer["EditQuestionIn"]
            <strong>@(quiz?.Title ?? Localizer["Quiz"].Value)</strong>
        </p>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                @Localizer["QuestionInformation"]
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="QuizId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Question -->
                <div class="mb-3">

                    <label asp-for="QuestionText"
                           class="form-label fw-semibold">
                        @Localizer["Question"]
                    </label>

                    <textarea asp-for="QuestionText"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="QuestionText"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <!-- Mark -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Mark"
                               class="form-label fw-semibold">
                            @Localizer["Mark"]
                        </label>

                        <input asp-for="Mark"
                               type="number"
                               min="1"
                               max="100"
                               class="form-control" />

                        <span asp-validation-for="Mark"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Type -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="QuestionType"
                               class="form-label fw-semibold">
                            @Localizer["QuestionType"]
                        </label>

                        <select asp-for="QuestionType"
                                class="form-select">

                            <option value="MultipleChoice">
                                @Localizer["MultipleChoice"]
                            </option>

                            <option value="TrueFalse">
                                @Localizer["TrueFalse"]
                            </option>

                        </select>

                        <span asp-validation-for="QuestionType"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Options -->
                <div class="d-flex justify-content-between align-items-center mb-3">

                    <div>

                        <h5 class="mb-1">
                            @Localizer["QuestionOptions"]
                        </h5>

                        <small class="text-muted">
                            @Localizer["OptionsHelpText"]
                        </small>

                    </div>

                    <button type="button"
                            id="addOption"
                            class="btn btn-outline-primary">
                        <i class="bi bi-plus-lg"></i>
                        @Localizer["AddOption"]
                    </button>

                </div>

                <div id="optionsContainer">

                    @if (Model.QuestionOptions != null &&
                         Model.QuestionOptions.Any())
                    {
                        for (int i = 0;
                             i < Model.QuestionOptions.Count;
                             i++)
                        {
                            <div class="option-row border rounded p-3 mb-3">

                                <input type="hidden"
                                       name="QuestionOptions[@i].Id"
                                       value="@Model.QuestionOptions[i].Id" />

                                <input type="hidden"
                                       name="QuestionOptions[@i].QuestionId"
                                       value="@Model.Id" />

                                <div class="row align-items-center">

                                    <div class="col-md-9">

                                        <label class="form-label">
                                            @Localizer["Option"]
                                        </label>

                                        <input name="QuestionOptions[@i].OptionText"
                                               value="@Model.QuestionOptions[i].OptionText"
                                               class="form-control"
                                               placeholder="@Localizer["EnterOptionPlaceholder"]" />

                                    </div>

                                    <div class="col-md-3">

                                        <div class="form-check mt-4">

                                            <input name="QuestionOptions[@i].IsCorrect"
                                                   type="checkbox"
                                                   value="true"
                                                   class="form-check-input"
                                            @(Model.QuestionOptions[i].IsCorrect
                                                ? "checked"
                                                : "") />

                                            <input name="QuestionOptions[@i].IsCorrect"
                                                   type="hidden"
                                                   value="false" />

                                            <label class="form-check-label">
                                                @Localizer["CorrectAnswer"]
                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="option-row border rounded p-3 mb-3">

                            <div class="row">

                                <div class="col-md-9">

                                    <label class="form-label">
                                        @Localizer["Option"]
                                    </label>

                                    <input name="QuestionOptions[0].OptionText"
                                           class="form-control" />

                                </div>

                                <div class="col-md-3">

                                    <div class="form-check mt-4">

                                        <input name="QuestionOptions[0].IsCorrect"
                                               type="checkbox"
                                               value="true"
                                               class="form-check-input" />

                                        <input name="QuestionOptions[0].IsCorrect"
                                               type="hidden"
                                               value="false" />

                                        <label class="form-check-label">
                                            @Localizer["CorrectAnswer"]
                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       asp-route-quizId="@Model.QuizId"
                       class="btn btn-outline-secondary">
                        @Localizer["Cancel"]
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        @Localizer["SaveChanges"]
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let optionIndex =
            document.querySelectorAll(".option-row").length;

        document.getElementById("addOption")
            .addEventListener("click", function() {

                const container =
                    document.getElementById("optionsContainer");

                const div =
                    document.createElement("div");

                div.className =
                    "option-row border rounded p-3 mb-3";

                div.innerHTML = `
                            <div class="row align-items-center">

                                <div class="col-md-9">

                                    <label class="form-label">
                                        @Localizer["Option"]
                                    </label>

                                    <input
                                        name="QuestionOptions[${optionIndex}].OptionText"
                                        class="form-control"
                                        placeholder="@Localizer["EnterOptionPlaceholder"]" />

                                </div>

                                <div class="col-md-3">

                                    <div class="form-check mt-4">

                                        <input
                                            name="QuestionOptions[${optionIndex}].IsCorrect"
                                            type="checkbox"
                                            value="true"
                                            class="form-check-input" />

                                        <input
                                            name="QuestionOptions[${optionIndex}].IsCorrect"
                                            type="hidden"
                                            value="false" />

                                        <label class="form-check-label">
                                            @Localizer["CorrectAnswer"]
                                        </label>

                                    </div>

                                </div>

                            </div>
                        `;

                container.appendChild(div);

                optionIndex++;
            });

    </script>
}