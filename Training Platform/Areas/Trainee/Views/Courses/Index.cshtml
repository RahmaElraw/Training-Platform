@model IEnumerable<Training_Platform.Models.Course>

@{
    ViewData["Title"] = "Courses";
    var categories = ViewBag.Categories as IEnumerable<Training_Platform.Models.Category> ?? [];
    int? selectedCategory = ViewBag.CategoryId as int?;
    string? selectedLevel = ViewBag.Level as string;
    bool hasFilters = !string.IsNullOrWhiteSpace(ViewBag.Query) || selectedCategory.HasValue || !string.IsNullOrWhiteSpace(selectedLevel);
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Courses</h4>
            <p class="text-secondary small mb-0">
                Explore our available training courses.
            </p>
        </div>
    </div>

    <!-- Search & Filter Form -->
    <form asp-action="Index" method="get" class="row g-2 mb-3">

        <!-- Search Input -->
        <div class="col-md-4">
            <input type="text"
                   name="query"
                   value="@ViewBag.Query"
                   class="form-control form-control-sm"
                   placeholder="Search by title or description..." />
        </div>

        <!-- Category Dropdown -->
        <div class="col-md-3">
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id" selected="@(selectedCategory == cat.Id ? "selected" : null)">
                        @cat.Name
                    </option>
                }
            </select>
        </div>

        <!-- Level Dropdown -->
        <div class="col-md-3">
            <select name="level" class="form-select form-select-sm">
                <option value="">All Levels</option>
                <option value="Beginner" selected="@(selectedLevel == "Beginner" ? "selected" : null)">Beginner</option>
                <option value="Intermediate" selected="@(selectedLevel == "Intermediate" ? "selected" : null)">Intermediate</option>
                <option value="Advanced" selected="@(selectedLevel == "Advanced" ? "selected" : null)">Advanced</option>
            </select>
        </div>

        <!-- Submit & Clear Buttons -->
        <div class="col-md-2 d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary w-100">
                <i class="fas fa-filter me-1"></i> Filter
            </button>

            @if (hasFilters)
            {
                <a asp-action="Index" class="btn btn-sm btn-secondary">
                    <i class="fas fa-times"></i>
                </a>
            }
        </div>
    </form>

    <!-- Courses Grid -->
    @if (Model.Any())
    {
        <!-- 4 columns on XL, 3 on LG, 2 on MD/SM -->
        <div class="row g-3">
            @foreach (var course in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0">

                        <!-- Thumbnail -->
                        @if (!string.IsNullOrWhiteSpace(course.Thumbnail))
                        {
                            <img src="@course.Thumbnail"
                                 class="card-img-top"
                                 alt="@course.Title"
                                 style="height: 140px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 140px;">
                                <i class="fas fa-book-open fa-2x text-secondary"></i>
                            </div>
                        }

                        <div class="card-body d-flex flex-column p-3">

                            <!-- Title -->
                            <h6 class="card-title text-dark fw-bold mb-2 text-truncate" title="@course.Title">
                                @course.Title
                            </h6>

                            <!-- Description -->
                            <p class="card-text text-secondary small mb-3">
                                @{
                                    var description = course.Description ?? "";
                                    if (description.Length > 80)
                                    {
                                        description = description.Substring(0, 80) + "...";
                                    }
                                }
                                @description
                            </p>

                            <!-- Course Info -->
                            <div class="mt-auto">
                                <div class="d-flex justify-content-between text-secondary small mb-2">
                                    <span>
                                        <i class="fas fa-clock me-1 text-primary"></i>
                                        @course.DurationInHours Hrs
                                    </span>
                                    <span>
                                        <i class="fas fa-layer-group me-1 text-primary"></i>
                                        @course.Lessons.Count Lessons
                                    </span>
                                </div>

                                <!-- Level + Category + Average Rating -->
                                <div class="d-flex justify-content-between align-items-center mb-3 gap-1">
                                    <div class="text-truncate">
                                        <span class="badge bg-primary text-truncate" style="max-width: 70px;">@course.Level</span>
                                        @if (course.Category != null)
                                        {
                                            <span class="badge bg-secondary text-truncate" style="max-width: 80px;">@course.Category.Name</span>
                                        }
                                    </div>

                                    @{
                                        var hasReviews = course.Reviews != null && course.Reviews.Any();
                                        var avgRating = hasReviews ? Math.Round(course.Reviews.Average(r => r.Rating), 1) : 0;
                                        var reviewCount = hasReviews ? course.Reviews.Count : 0;
                                    }

                                    <div class="text-warning small d-flex align-items-center flex-shrink-0" title="@avgRating out of 5 stars">
                                        <i class="fas fa-star me-1"></i>
                                        <span class="fw-bold text-dark me-1">@(avgRating > 0 ? avgRating.ToString("0.0") : "N/A")</span>
                                        <span class="text-secondary small">(@reviewCount)</span>
                                    </div>
                                </div>

                                <!-- View Button -->
                                <a asp-action="Details"
                                   asp-route-id="@course.Id"
                                   class="btn btn-sm btn-primary w-100">
                                    <i class="fas fa-eye me-1"></i> View Course
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="d-flex justify-content-center mt-4">
                <nav aria-label="Course page navigation">
                    <ul class="pagination pagination-sm mb-0">

                        <!-- Previous Button -->
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-query="@ViewBag.Query"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-level="@ViewBag.Level"
                               asp-route-page="@(ViewBag.CurrentPage - 1)"
                               aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-query="@ViewBag.Query"
                                   asp-route-categoryId="@ViewBag.CategoryId"
                                   asp-route-level="@ViewBag.Level"
                                   asp-route-page="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Next Button -->
                        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-query="@ViewBag.Query"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-level="@ViewBag.Level"
                               asp-route-page="@(ViewBag.CurrentPage + 1)"
                               aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <i class="fas fa-book-open fa-2x text-secondary mb-2"></i>
                <h6 class="text-dark fw-bold">No courses found</h6>

                @if (hasFilters)
                {
                    <p class="text-secondary small mb-3">No courses match your active filter criteria.</p>
                    <a asp-action="Index" class="btn btn-sm btn-secondary">Clear Filters</a>
                }
                else
                {
                    <p class="text-secondary small mb-0">There are no published courses available.</p>
                }
            </div>
        </div>
    }
</div>