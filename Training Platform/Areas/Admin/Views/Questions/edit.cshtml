@using Training_Platform.Models
@model Training_Platform.ViewModels.QuestionVM

<div class="card shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">
            <i class="fas fa-edit me-1"></i>
            Edit Question
        </h5>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger mb-4">
            </div>


            <!-- Question Information -->

            <div class="row">

                <!-- Question Text -->

                <div class="col-md-12 mb-3">

                    <label asp-for="QuestionText"
                           class="form-label">
                        Question
                        <span class="text-danger">*</span>
                    </label>

                    <textarea asp-for="QuestionText"
                              class="form-control"
                              rows="4"
                              placeholder="Enter question..."></textarea>

                    <span asp-validation-for="QuestionText"
                          class="text-danger">
                    </span>

                </div>


                <!-- Quiz -->

                <div class="col-md-6 mb-3">

                    <label asp-for="QuizId"
                           class="form-label">
                        Quiz
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="QuizId"
                            asp-items="ViewBag.Quizzes"
                            class="form-select">

                        <option value="">
                            -- Select Quiz --
                        </option>

                    </select>

                    <span asp-validation-for="QuizId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Mark -->

                <div class="col-md-3 mb-3">

                    <label asp-for="Mark"
                           class="form-label">
                        Mark
                        <span class="text-danger">*</span>
                    </label>

                    <input asp-for="Mark"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="Mark"
                          class="text-danger">
                    </span>

                </div>


                <!-- Question Type -->

                <div class="col-md-3 mb-3">

                    <label asp-for="QuestionType"
                           class="form-label">
                        Question Type
                        <span class="text-danger">*</span>
                    </label>

                    <select asp-for="QuestionType"
                            asp-items="Html.GetEnumSelectList<QuestionType>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="QuestionType"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <hr class="my-4" />


            <!-- Question Options -->

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="mb-0">
                    <i class="fas fa-list me-1"></i>
                    Question Options
                </h5>


                @if (Model.QuestionType == QuestionType.TrueFalse &&
                     Model.QuestionOptions != null &&
                     Model.QuestionOptions.Count >= 2)
                {
                    <span class="badge bg-secondary">
                        <i class="fas fa-check me-1"></i>
                        True / False question is complete
                    </span>
                }
                else
                {
                    <button type="button"
                            class="btn btn-success btn-sm"
                            data-bs-toggle="modal"
                            data-bs-target="#addOptionModal">

                        <i class="fas fa-plus me-1"></i>
                        Add Option

                    </button>
                }

            </div>


            <!-- Options -->
            @if (Model.QuestionOptions != null &&
                             Model.QuestionOptions.Any())
            {
                <div class="list-group mb-4">

                    @foreach (var option in Model.QuestionOptions)
                    {
                        <div class="list-group-item">

                            <div class="d-flex justify-content-between align-items-center">

                                <!-- Option Text -->

                                <div>

                                    <span class="fw-semibold">
                                        @option.OptionText
                                    </span>

                                    @if (option.IsCorrect)
                                    {
                                        <span class="badge bg-success ms-2">
                                            <i class="fas fa-check me-1"></i>
                                            Correct
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary ms-2">
                                            Incorrect
                                        </span>
                                    }

                                </div>


                                <!-- Actions -->

                                <div class="d-flex gap-2">

                                    <!-- Edit -->

                                    <a asp-action="EditOption"
                                       asp-route-id="@option.Id"
                                       class="btn btn-sm btn-primary">

                                        <i class="fas fa-edit me-1"></i>
                                        Edit

                                    </a>


                                    <!-- Delete -->

                                    <form asp-action="DeleteOption"
                                          asp-route-id="@option.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this option?');">

                                            <i class="fas fa-trash me-1"></i>
                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="alert alert-info mb-4">

                    <i class="fas fa-info-circle me-1"></i>

                    No options added yet.

                </div>
            }


            <!-- Question Actions -->

            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    Save Changes

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Cancel

                </a>

            </div>

        </form>


        <!-- Add Option Modal -->

        <div class="modal fade"
             id="addOptionModal"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog">

                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                            <i class="fas fa-plus me-1"></i>
                            Add Question Option
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal">
                        </button>

                    </div>


                    <!-- Add Option Form -->

                    <form asp-action="AddOption"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="modal-body">

                            <input type="hidden"
                                   name="QuestionId"
                                   value="@Model.Id" />


                            <!-- Option Text -->

                            <div class="mb-3">

                                <label class="form-label">
                                    Option Text
                                    <span class="text-danger">*</span>
                                </label>


                                @if (Model.QuestionType == QuestionType.TrueFalse)
                                {
                                    <select name="OptionText"
                                            class="form-select"
                                            required>

                                        <option value="">
                                            -- Select Answer --
                                        </option>

                                        <option value="True">
                                            True
                                        </option>

                                        <option value="False">
                                            False
                                        </option>

                                    </select>
                                }
                                else
                                {
                                    <input type="text"
                                           name="OptionText"
                                           class="form-control"
                                           maxlength="500"
                                           placeholder="Enter option..."
                                           required />
                                }

                            </div>


                            <!-- Correct Answer -->

                            <div class="form-check">

                                <input type="checkbox"
                                       name="IsCorrect"
                                       value="true"
                                       class="form-check-input"
                                       id="addOptionIsCorrect" />

                                <label class="form-check-label"
                                       for="addOptionIsCorrect">

                                    Correct Answer

                                </label>

                            </div>

                        </div>


                        <!-- Footer -->

                        <div class="modal-footer">

                            <button type="button"
                                    class="btn btn-secondary"
                                    data-bs-dismiss="modal">

                                Cancel

                            </button>

                            <button type="submit"
                                    class="btn btn-success">

                                <i class="fas fa-plus me-1"></i>
                                Add Option

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}