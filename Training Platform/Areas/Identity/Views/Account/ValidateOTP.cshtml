@model Training_Platform.ViewModels.ValidateOTPVM

@{
    ViewData["Title"] = Localizer["VerifyOTP"];
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">@Localizer["VerifyOTP"]</h2>
    <p class="text-muted mb-0">@Localizer["EnterVerificationCodeSentToEmail"]</p>
</div>

<form asp-action="ValidateOTP" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-4">
        <label asp-for="OTP" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-shield-lock"></i>
            <input asp-for="OTP" class="form-control" placeholder="@Localizer["EnterOTPCode"]" />
        </div>
        <span asp-validation-for="OTP" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <input type="submit" value="@Localizer["Verify"]" class="btn btn-primary btn-lg" />
    </div>

    <div class="text-center mt-3">
        <span class="text-muted">@Localizer["DidntReceiveCode"]</span>
        <button type="submit" formaction="@Url.Action("ResendOTP")" formnovalidate
                class="btn btn-link p-0 text-primary text-decoration-none fw-semibold" style="vertical-align: baseline;">
            @Localizer["Resend"]
        </button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}