<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Training_Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Areas\Admin\Data\**" />
    <Compile Remove="Areas\Admin\Models\**" />
    <Compile Remove="Areas\Trainee\Data\**" />
    <Compile Remove="Areas\Trainee\Models\**" />
    <Compile Remove="Areas\Trainer\Data\**" />
    <Compile Remove="Areas\Trainer\Models\**" />
    <Content Remove="Areas\Admin\Data\**" />
    <Content Remove="Areas\Admin\Models\**" />
    <Content Remove="Areas\Trainee\Data\**" />
    <Content Remove="Areas\Trainee\Models\**" />
    <Content Remove="Areas\Trainer\Data\**" />
    <Content Remove="Areas\Trainer\Models\**" />
    <EmbeddedResource Remove="Areas\Admin\Data\**" />
    <EmbeddedResource Remove="Areas\Admin\Models\**" />
    <EmbeddedResource Remove="Areas\Trainee\Data\**" />
    <EmbeddedResource Remove="Areas\Trainee\Models\**" />
    <EmbeddedResource Remove="Areas\Trainer\Data\**" />
    <EmbeddedResource Remove="Areas\Trainer\Models\**" />
    <None Remove="Areas\Admin\Data\**" />
    <None Remove="Areas\Admin\Models\**" />
    <None Remove="Areas\Trainee\Data\**" />
    <None Remove="Areas\Trainee\Models\**" />
    <None Remove="Areas\Trainer\Data\**" />
    <None Remove="Areas\Trainer\Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Areas\Admin\Controllers\" />
    <Folder Include="Areas\Admin\Views\" />
    <Folder Include="Areas\Trainee\Views\" />
    <Folder Include="Areas\Trainer\Controllers\" />
    <Folder Include="Areas\Trainer\Views\" />
  </ItemGroup>

</Project>
