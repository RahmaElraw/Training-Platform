@model Training_Platform.Models.Enrollment

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            @Localizer["EnrollmentDetails"]
        </h5>

        <a asp-action="Index"
           class="btn btn-secondary btn-sm">

            <i class="fas fa-arrow-left me-1"></i>
            @Localizer["Back"]

        </a>

    </div>


    <div class="card-body">

        <div class="row">

            <div class="col-md-6">

                <h5>
                    @Localizer["Trainee"]
                </h5>

                <p>
                    @(Model.User?.UserName ?? Localizer["UnknownUser"].Value)
                </p>

            </div>


            <div class="col-md-6">

                <h5>
                    @Localizer["Course"]
                </h5>

                <p>
                    @(Model.Course?.Title ?? Localizer["UnknownCourse"].Value)
                </p>

            </div>

        </div>


        <hr />


        <div class="row">

            <div class="col-md-6">

                <strong>@Localizer["EnrollmentDate"]</strong>

                <p>
                    @Model.EnrollmentDate
                    .ToString("dd/MM/yyyy HH:mm")
                </p>

            </div>


            <div class="col-md-6">

                <strong>@Localizer["Status"]</strong>

                <p>

                    @if (Model.IsCompleted)
                    {
                        <span class="badge bg-success">
                            @Localizer["Completed"]
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">
                            @Localizer["InProgress"]
                        </span>
                    }

                </p>

            </div>

        </div>


        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-edit me-1"></i>
                @Localizer["Edit"]

            </a>

        </div>

    </div>

</div>
