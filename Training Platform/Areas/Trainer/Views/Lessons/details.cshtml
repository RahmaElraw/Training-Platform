@using Training_Platform.Models
@model Lesson

@{
    ViewData["Title"] = Localizer["LessonDetails"];
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                @Localizer["LessonDetails"]
            </h2>

            <p class="text-muted mb-0">
                @Localizer["ViewLessonInfo"]
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                @Localizer["Edit"]

            </a>

            <a asp-action="Index"
               asp-route-courseId="@Model.CourseId"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                @Localizer["BackToLessons"]

            </a>

        </div>

    </div>


    <!-- Lesson Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-book-open me-2"></i>
                @Localizer["LessonInformation"]
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Main Information -->
                <div class="col-md-8">

                    <h4 class="fw-bold mb-3">
                        @Model.Title
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted mb-0">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            @Localizer["NoDescriptionAvailable"]
                        </p>
                    }

                </div>


                <!-- Course & Order -->
                <div class="col-md-4">

                    <div class="mb-3">

                        <strong>
                            @Localizer["CourseLabel"]
                        </strong>

                        <div class="mt-1">
                            @(Model.Course?.Title ?? "N/A")
                        </div>

                    </div>


                    <div>

                        <strong>
                            @Localizer["OrderLabel"]
                        </strong>

                        <div class="mt-1">

                            <span class="badge bg-secondary">
                                @Localizer["Lesson"] @Model.OrderNumber
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Lesson Video -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-play-circle me-2"></i>
                @Localizer["LessonVideo"]
            </h5>

        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
            {
                <div class="mb-3">

                    <a href="@Model.VideoUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline-primary">

                        <i class="bi bi-box-arrow-up-right me-1"></i>
                        @Localizer["OpenVideo"]

                    </a>

                </div>

                <div>

                    <small class="text-muted">
                        @Localizer["VideoUrl"]
                    </small>

                    <div class="text-break mt-1">
                        @Model.VideoUrl
                    </div>

                </div>
            }
            else
            {
                <div class="text-center py-3">

                    <i class="bi bi-camera-video-off fs-2 text-muted"></i>

                    <p class="text-muted mt-2 mb-0">
                        @Localizer["NoVideoAvailable"]
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- Course Materials -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-1">
                        <i class="bi bi-folder2-open me-2"></i>
                        @Localizer["CourseMaterials"]
                    </h5>

                    <small class="text-muted">
                        @Localizer["MaterialsSubtitle"]
                    </small>

                </div>


                <!-- Manage Materials -->
                <a asp-area="Trainer"
                   asp-controller="Materials"
                   asp-action="Index"
                   asp-route-lessonId="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-folder2-open me-1"></i>
                    @Localizer["ManageMaterials"]

                </a>

            </div>

        </div>


        <div class="card-body">

            @if (Model.CourseMaterials != null &&
                 Model.CourseMaterials.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead>

                            <tr>

                                <th style="width: 70px;">
                                    #
                                </th>

                                <th>
                                    @Localizer["Material"]
                                </th>

                                <th>
                                    @Localizer["Link"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int materialCounter = 1;
                            }

                            @foreach (var material in Model.CourseMaterials)
                            {
                                <tr>

                                    <td>
                                        @materialCounter
                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @material.Title
                                        </div>

                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(material.Url))
                                        {
                                            <a href="@material.Url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                                @Localizer["Open"]

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                @Localizer["NoUrl"]
                                            </span>
                                        }

                                    </td>

                                </tr>

                                materialCounter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-file-earmark-x fs-1 text-muted"></i>

                    <h6 class="mt-3">
                        @Localizer["NoCourseMaterials"]
                    </h6>

                    <p class="text-muted mb-3">
                        @Localizer["NoMaterialsAddedYet"]
                    </p>

                    <a asp-area="Trainer"
                       asp-controller="Materials"
                       asp-action="Create"
                       asp-route-lessonId="@Model.Id"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        @Localizer["AddFirstMaterial"]

                    </a>

                </div>
            }

        </div>

    </div>


    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center">

        <a asp-action="Index"
           asp-route-courseId="@Model.CourseId"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            @Localizer["BackToLessons"]

        </a>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                @Localizer["EditLesson"]

            </a>

        </div>

    </div>

</div>