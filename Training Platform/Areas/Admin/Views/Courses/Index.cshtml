@model Training_Platform.ViewModels.CourseWithRelatedVM

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            @Localizer["AllCourses"]
        </h5>

        <a asp-action="Create" class="btn btn-primary">

            <i class="fas fa-plus me-1"></i>

            @Localizer["AddCourse"]

        </a>

    </div>


    <div class="card-body">

        <!-- Search -->

        <form method="get">

            <div class="input-group">

                <input asp-for="Query"
                       name="query"
                       class="form-control"
                       placeholder="@Localizer["SearchCoursePlaceholder"]" />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-search"></i>

                </button>

            </div>

        </form>

    </div>

</div>


<!-- No Courses -->

@if (!Model.Courses.Any())
{
    <div class="alert alert-warning">

        @Localizer["NoCoursesFound"]

    </div>
}


<!-- Courses -->

@foreach (var item in Model.Courses)
{
    <article class="card mb-3 overflow-hidden shadow-sm">

        <div class="card-body">

            <div class="row">

                <!-- Course Information -->

                <div class="col-md-9">

                    <div class="d-flex align-items-start gap-3">

                        <!-- Thumbnail -->

                        @if (!string.IsNullOrWhiteSpace(item.Thumbnail))
                        {
                            <img src="@item.Thumbnail"
                                 alt="@item.Title"
                                 class="rounded"
                                 style="width: 120px;
                                        height: 80px;
                                        object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-secondary text-white rounded
                                        d-flex align-items-center justify-content-center"
                                 style="width: 120px;
                                        height: 80px;">

                                <i class="fas fa-book fa-2x"></i>

                            </div>
                        }


                        <!-- Title + Description -->

                        <div>

                            <h4 class="mb-1">
                                @item.Title
                            </h4>

                            <p class="text-muted mb-2">

                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? Localizer["NoDescription"]
                                    : item.Description)

                            </p>

                        </div>

                    </div>


                    <!-- Course Information -->

                    <div class="d-flex flex-wrap gap-4 mt-3">

                        <span>

                            <strong>@Localizer["Category"]</strong>

                            @(item.Category?.Name ?? Localizer["NoCategory"].Value)

                        </span>


                        <span>

                            <strong>@Localizer["Trainer"]</strong>

                            @(item.Trainer?.UserName ?? Localizer["NoTrainer"].Value)

                        </span>


                        <span>

                            <strong>@Localizer["Duration"]</strong>

                            @item.DurationInHours @Localizer["Hours"]

                        </span>


                        <span>

                            <strong>@Localizer["Level"]</strong>

                            @switch (item.Level)
                            {
                                case Training_Platform.Models.CourseLevel.Beginner:

                                    <span class="badge bg-success">
                                        @Localizer["Beginner"]
                                    </span>

                                    break;

                                case Training_Platform.Models.CourseLevel.Intermediate:

                                    <span class="badge bg-warning text-dark">
                                        @Localizer["Intermediate"]
                                    </span>

                                    break;

                                case Training_Platform.Models.CourseLevel.Advanced:

                                    <span class="badge bg-danger">
                                        @Localizer["Advanced"]
                                    </span>

                                    break;
                            }

                        </span>


                        <span>

                            <strong>@Localizer["Status"]</strong>

                            @if (item.IsPublished)
                            {
                                <span class="badge bg-success">
                                    @Localizer["Published"]
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @Localizer["Draft"]
                                </span>
                            }

                        </span>

                    </div>


                    <!-- Related Data -->

                    <div class="d-flex gap-4 mt-3">

                        <span>

                            <strong>@Localizer["Lessons"]</strong>

                            @item.Lessons.Count

                        </span>


                        <span>

                            <strong>@Localizer["Quizzes"]</strong>

                            @item.Quizzes.Count

                        </span>


                        <span>

                            <strong>@Localizer["Enrollments"]</strong>

                            @item.Enrollments.Count

                        </span>


                        <span>

                            <strong>@Localizer["Reviews"]</strong>

                            @item.Reviews.Count

                        </span>

                    </div>


                    <!-- Created Date -->

                    <div class="mt-3 text-muted">

                        <small>

                            <i class="fas fa-calendar me-1"></i>

                            @Localizer["Created"]

                            @item.CreatedAt.ToString("dd/MM/yyyy")

                        </small>

                    </div>

                </div>


                <!-- Actions -->

                <div class="col-md-3">

                    <div class="d-grid gap-2">

                        <!-- Details -->

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info text-white">

                            <i class="fas fa-eye me-1"></i>

                            @Localizer["Details"]

                        </a>
                        <!-- Related Courses -->

                        <a asp-action="RelatedCourses"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-info">

                            <i class="fas fa-layer-group me-1"></i>

                            @Localizer["RelatedCourses"]

                        </a>

                        <!-- Edit -->

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-primary">

                            <i class="fas fa-edit me-1"></i>

                            @Localizer["Edit"]

                        </a>


                        <!-- Delete -->

                        <button type="button"
                                class="btn btn-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteCourseModal"
                                data-id="@item.Id"
                                data-name="@item.Title">

                            <i class="fas fa-trash-alt me-1"></i>

                            @Localizer["Delete"]

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </article>
}


<!-- Delete Modal -->

<div class="modal fade"
     id="deleteCourseModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Localizer["DeleteCourse"]
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body">

                @Localizer["AreYouSureYouWantToDelete"]

                <strong id="courseName"></strong> ?

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    @Localizer["Cancel"]

                </button>


                <form id="deleteCourseForm"
                      method="post"
                      asp-action="Delete">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="courseId"
                           name="id" />

                    <button type="submit"
                            class="btn btn-danger">

                        @Localizer["Delete"]

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- Pagination -->

@if (Model.TotalPages > 1)
{
    <nav>

        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item
                    @(i == Model.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-query="@Model.Query">

                        @i

                    </a>

                </li>
            }

        </ul>

    </nav>
}


@section Scripts
{
    <script>

        const deleteModal =
            document.getElementById('deleteCourseModal');

        deleteModal.addEventListener(
            'show.bs.modal',
            function (event)
            {
                const button = event.relatedTarget;

                const id =
                    button.getAttribute('data-id');

                const name =
                    button.getAttribute('data-name');

                document.getElementById('courseName')
                    .textContent = name;

                document.getElementById('courseId')
                    .value = id;
            });

    </script>
}
