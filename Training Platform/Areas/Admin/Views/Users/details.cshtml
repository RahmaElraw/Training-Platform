@model Training_Platform.Models.ApplicationUser

@{
    ViewData["Title"] = "User Details";
}

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">User Details</h5>
    </div>

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                User Name
            </div>

            <div class="col-md-9">
                @Model.UserName
            </div>

        </div>

        <hr />

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Email
            </div>

            <div class="col-md-9">
                @Model.Email
            </div>

        </div>

        <hr />

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Phone Number
            </div>

            <div class="col-md-9">
                @(string.IsNullOrEmpty(Model.PhoneNumber) ? "Not Provided" : Model.PhoneNumber)
            </div>

        </div>

        <hr />

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                Status
            </div>

            <div class="col-md-9">

                @if (Model.IsApproved)
                {
                    <span class="badge bg-success">
                        Approved
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        Pending
                    </span>
                }

            </div>

        </div>

        <hr />

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                Created At
            </div>

            <div class="col-md-9">
                @Model.CreatedAt.ToString("dd MMM yyyy")
            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                Edit

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">

                Delete

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

</div>