@using Training_Platform.Models
@model IEnumerable<Quiz>

@{
    ViewData["Title"] = "Course Quizzes";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Course Quizzes</h2>

            <p class="text-muted mb-0">
                Manage quizzes for
                <strong>@ViewBag.Course.Title</strong>
            </p>
        </div>

        <a asp-action="Create"
           asp-route-courseId="@ViewBag.Course.Id"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Add Quiz

        </a>

    </div>


    <!-- Quizzes Table -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Quizzes
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>#</th>
                                <th>Title</th>
                                <th>Passing Score</th>
                                <th>Time Limit</th>
                                <th class="text-center">Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var quiz in Model)
                            {
                                <tr>

                                    <td>
                                        @counter
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @quiz.Title
                                        </div>
                                    </td>

                                    <td>

                                        <span class="badge bg-success">
                                            @quiz.PassingScore%
                                        </span>

                                    </td>

                                    <td>

                                        <span class="badge bg-info text-dark">
                                            @quiz.TimeLimit min
                                        </span>

                                    </td>

                                    <td>

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@quiz.Id"
                                                  asp-route-courseId="@quiz.CourseId"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this quiz? All questions, options and quiz results will also be deleted.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-question-circle fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No quizzes found
                    </h5>

                    <p class="text-muted">
                        This course doesn't have any quizzes yet.
                    </p>

                    <a asp-action="Create"
                       asp-route-courseId="@ViewBag.Course.Id"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg"></i>
                        Create First Quiz

                    </a>

                </div>
            }

        </div>

    </div>

</div>