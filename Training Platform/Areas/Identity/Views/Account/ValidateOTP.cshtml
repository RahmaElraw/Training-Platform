@model Training_Platform.ViewModels.ValidateOTPVM

@{
    ViewData["Title"] = "Verify OTP";
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">Verify OTP</h2>
    <p class="text-muted mb-0">Enter the verification code sent to your email</p>
</div>

<form asp-action="ValidateOTP" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-4">
        <label asp-for="OTP" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-shield-lock"></i>
            <input asp-for="OTP" class="form-control" placeholder="Enter OTP code" />
        </div>
        <span asp-validation-for="OTP" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <input type="submit" value="Verify" class="btn btn-primary btn-lg" />
    </div>

    <div class="text-center mt-3">
        <span class="text-muted">Didn't receive the code?</span>
        <button type="submit" formaction="@Url.Action("ResendOTP")" formnovalidate
                class="btn btn-link p-0 text-primary text-decoration-none fw-semibold" style="vertical-align: baseline;">
            Resend
        </button>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}