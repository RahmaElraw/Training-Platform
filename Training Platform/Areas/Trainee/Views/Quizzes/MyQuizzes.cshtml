@model IEnumerable<Training_Platform.ViewModels.Trainee.TraineeQuizItemVM>

@{
    ViewData["Title"] = "My Quizzes";
}

<div class="container-fluid py-3">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-dark fw-bold">My Quizzes</h4>
            <p class="text-secondary small mb-0">
                View and take quizzes for your enrolled courses to evaluate your progress.
            </p>
        </div>
        <a asp-controller="Enrollments" asp-action="Index" class="btn btn-outline-primary btn-sm">
            <i class="fas fa-book me-1"></i> My Enrolled Courses
        </a>
    </div>

    @if (Model.Any())
    {
        <!-- 4 columns on XL, 3 on LG, 2 on MD/SM -->
        <div class="row g-3">
            @foreach (var quiz in Model)
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body d-flex flex-column p-3">

                            <!-- Course Title & Status Badge -->
                            <div class="d-flex justify-content-between align-items-center gap-1 mb-2">
                                <span class="badge bg-light text-primary border border-primary text-truncate" style="max-width: 60%;" title="@quiz.CourseTitle">
                                    @quiz.CourseTitle
                                </span>

                                @if (quiz.HasAttempted)
                                {
                                    if (quiz.IsPassed)
                                    {
                                        <span class="badge bg-success flex-shrink-0">
                                            <i class="fas fa-check-circle me-1"></i> Passed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger flex-shrink-0">
                                            <i class="fas fa-times-circle me-1"></i> Failed
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary flex-shrink-0">Not Attempted</span>
                                }
                            </div>

                            <!-- Quiz Title -->
                            <h6 class="card-title text-dark fw-bold mb-2 text-truncate" title="@quiz.QuizTitle">
                                @quiz.QuizTitle
                            </h6>

                            <!-- Meta Info -->
                            <div class="text-secondary small mb-3">
                                <div class="mb-1 text-truncate">
                                    <i class="fas fa-question-circle me-1 text-primary"></i>
                                    @quiz.QuestionCount Questions (@quiz.TotalPossibleScore Marks)
                                </div>
                                <div class="mb-1 text-truncate">
                                    <i class="fas fa-clock me-1 text-primary"></i>
                                    Time: @quiz.TimeLimitMinutes Mins
                                </div>
                                <div class="text-truncate">
                                    <i class="fas fa-bullseye me-1 text-primary"></i>
                                    Passing Score: @quiz.PassingScore
                                </div>
                            </div>

                            <!-- Best Score Summary -->
                            @if (quiz.HasAttempted)
                            {
                                <div class="py-1 px-2 bg-light rounded mb-3 text-center small">
                                    <span class="text-muted me-1">Best Score:</span>
                                    <span class="fw-bold @(quiz.IsPassed ? "text-success" : "text-danger")">
                                        @quiz.BestScore / @quiz.TotalPossibleScore
                                    </span>
                                </div>
                            }

                            <!-- Action Button -->
                            <div class="mt-auto">
                                <a asp-action="Take"
                                   asp-route-id="@quiz.QuizId"
                                   class="btn btn-sm @(quiz.HasAttempted ? "btn-info text-white" : "btn-primary") w-100">
                                    <i class="fas @(quiz.HasAttempted ? "fa-eye" : "fa-play") me-1"></i>
                                    @(quiz.HasAttempted ? "View Result" : "Start Quiz")
                                </a>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-4">
                <i class="fas fa-file-alt fa-2x text-secondary mb-2"></i>
                <h6 class="text-dark fw-bold">No Quizzes Available</h6>
                <p class="text-secondary small mb-3">
                    Enroll in courses to unlock quizzes and test your knowledge.
                </p>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-sm">
                    Browse Available Courses
                </a>
            </div>
        </div>
    }
</div>