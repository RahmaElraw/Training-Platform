@model Training_Platform.ViewModels.UserWithRelatedVM

@{
    ViewData["Title"] = "Users Management";
}

<!-- Alert Notifications -->
@if (TempData["Success"] != null || TempData["success_notification"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-check-circle me-1"></i>
        @(TempData["Success"] ?? TempData["success_notification"])
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null || TempData["error_notification"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
        <i class="fas fa-exclamation-triangle me-1"></i>
        @(TempData["Error"] ?? TempData["error_notification"])
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm">

    <!-- Card Header -->
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Users Management</h5>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add User
        </a>
    </div>

    <div class="card-body">

        <!-- Search Form -->
        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-md-5 col-lg-4">
                <input type="text"
                       name="query"
                       value="@Model.Query"
                       class="form-control"
                       placeholder="Search by Username or Email..." />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-search me-1"></i> Search
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <div class="col-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-1"></i> Clear
                    </a>
                </div>
            }
        </form>

        <!-- Users Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>User</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-center" style="width: 180px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        foreach (var item in Model.Users)
                        {
                            <tr>
                                <!-- Avatar & Username -->
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrWhiteSpace(item.User.ProfileImage))
                                        {
                                            <img src="~/images/profiles/@item.User.ProfileImage"
                                                 alt="@item.User.UserName"
                                                 class="rounded-circle me-2"
                                                 style="width: 36px; height: 36px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
                                                 style="width: 36px; height: 36px; font-weight: bold;">
                                                @(string.IsNullOrEmpty(item.User.UserName) ? "U" : item.User.UserName[..1].ToUpper())
                                            </div>
                                        }
                                        <strong>@(item.User.UserName ?? "N/A")</strong>
                                    </div>
                                </td>

                                <!-- Email -->
                                <td>@(item.User.Email ?? "-")</td>

                                <!-- Role -->
                                <td>
                                    @if (item.Role == "No Role")
                                    {
                                        <span class="badge bg-secondary">No Role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">@item.Role</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>
                                    @if (item.User.IsApproved)
                                    {
                                        <span class="badge bg-success">
                                            <i class="fas fa-check me-1"></i> Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i> Pending
                                        </span>
                                    }
                                </td>

                                <!-- Created -->
                                <td>
                                    @item.User.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <!-- Actions -->
                                <td class="text-center">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Details"
                                           asp-route-id="@item.User.Id"
                                           class="btn btn-info btn-sm text-white"
                                           title="Details">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.User.Id"
                                           class="btn btn-warning btn-sm"
                                           title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <form asp-action="ToggleStatus"
                                              asp-route-id="@item.User.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            @if (item.User.IsApproved)
                                            {
                                                <button type="submit"
                                                        class="btn btn-danger btn-sm"
                                                        title="Deactivate"
                                                        onclick="return confirm('Are you sure you want to deactivate this user?');">
                                                    <i class="fas fa-user-slash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-success btn-sm"
                                                        title="Activate"
                                                        onclick="return confirm('Are you sure you want to activate this user?');">
                                                    <i class="fas fa-user-check"></i>
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                <div class="text-muted">
                                    <i class="fas fa-users fa-2x mb-2 d-block"></i>
                                    <div>No Users Found.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination Footer -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white py-3">
            <nav aria-label="Users pagination">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-query="@Model.Query">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-query="@Model.Query">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-query="@Model.Query">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>