@model Training_Platform.Models.Certificate

@{
    ViewData["Title"] = Localizer["CertificateDetails"];
}

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">@Localizer["CertificateDetails"]</h5>
    </div>

    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                @Localizer["CertificateNumber"]
            </div>

            <div class="col-md-9">
                @Model.CertificateNumber
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                @Localizer["User"]
            </div>

            <div class="col-md-9">
                @Model.User.UserName
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                @Localizer["Email"]
            </div>

            <div class="col-md-9">
                @Model.User.Email
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                @Localizer["Course"]
            </div>

            <div class="col-md-9">
                @Model.Course.Title
            </div>
        </div>

        <hr />

        <div class="row mb-4">
            <div class="col-md-3 fw-bold">
                @Localizer["IssueDate"]
            </div>

            <div class="col-md-9">
                @Model.IssueDate.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">
                @Localizer["Back"]
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                @Localizer["Delete"]
            </a>

        </div>

    </div>

</div>
