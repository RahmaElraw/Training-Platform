@model Training_Platform.ViewModels.LessonWithRelatedVM

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            All Lessons
        </h5>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fas fa-plus me-1"></i>
            Add Lesson

        </a>

    </div>


    <div class="card-body">

        <form method="get">

            <div class="input-group">

                <input asp-for="Query"
                       name="query"
                       class="form-control"
                       placeholder="Search lesson..." />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-search"></i>

                </button>

            </div>

        </form>

    </div>

</div>


@if (!Model.Lessons.Any())
{
    <div class="alert alert-warning">
        No Lessons Found.
    </div>
}


@foreach (var item in Model.Lessons)
{
    <article class="card mb-3 shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-9">

                    <h4 class="mb-2">
                        @item.OrderNumber. @item.Title
                    </h4>

                    <p class="text-muted">
                        @(string.IsNullOrWhiteSpace(item.Description)
                            ? "No Description"
                            : item.Description)
                    </p>

                    <div class="d-flex flex-wrap gap-4">

                        <span>
                            <strong>Course:</strong>
                            @(item.Course?.Title ?? "No Course")
                        </span>

                        <span>
                            <strong>Order:</strong>
                            @item.OrderNumber
                        </span>

                        <span>
                            <strong>Materials:</strong>
                            @item.CourseMaterials.Count
                        </span>

                        <span>
                            <strong>Progress Records:</strong>
                            @item.UserProgresses.Count
                        </span>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="d-grid gap-2">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info text-white">

                            <i class="fas fa-eye me-1"></i>
                            Details

                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-primary">

                            <i class="fas fa-edit me-1"></i>
                            Edit

                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger w-100"
                                    onclick="return confirm('Are you sure you want to delete this lesson?');">

                                <i class="fas fa-trash-alt me-1"></i>
                                Delete

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </article>
}


@if (Model.TotalPages > 1)
{
    <nav>

        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item
                    @(i == Model.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-query="@Model.Query">

                        @i

                    </a>

                </li>
            }

        </ul>

    </nav>
}