@using Training_Platform.Models
@model Quiz

@{
    ViewData["Title"] = @Localizer["PageTitle"];

    var questions = Model.Questions?
        .OrderBy(q => q.Id)
        .ToList()
        ?? new List<Question>();

    var results = Model.QuizResults?
        .OrderByDescending(r => r.SubmittedAt)
        .ToList()
        ?? new List<QuizResult>();

    var totalMarks = questions.Sum(q => q.Mark);
}

<div class="container-fluid">

    <!-- ================= HEADER ================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clipboard-check me-2"></i>
                @Localizer["PageTitle"]
            </h2>

            <p class="text-muted mb-0">
                @Localizer["PageSubtitle"]
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil me-1"></i>
                @Localizer["Edit"]

            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                @Localizer["BackToQuizzes"]

            </a>

        </div>

    </div>


    <!-- ================= QUIZ INFORMATION ================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-info-circle me-2"></i>
                @Localizer["QuizInformation"]
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- Title -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        @Localizer["QuizTitle"]
                    </div>

                    <div class="fw-semibold fs-5">
                        @Model.Title
                    </div>

                </div>


                <!-- Course -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        @Localizer["Course"]
                    </div>

                    <div class="fw-semibold">
                        @(Model.Course?.Title ?? Localizer["UnknownCourse"].Value)
                    </div>

                </div>


                <!-- Passing Score -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        @Localizer["PassingScore"]
                    </div>

                    <div class="fw-semibold">
                        @Model.PassingScore%
                    </div>

                </div>


                <!-- Time Limit -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        @Localizer["TimeLimit"]
                    </div>

                    <div class="fw-semibold">
                        @Model.TimeLimit @Localizer["Minutes"]
                    </div>

                </div>


                <!-- Questions -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        @Localizer["Questions"]
                    </div>

                    <div class="fw-semibold">
                        @questions.Count
                    </div>

                </div>


                <!-- Total Marks -->
                <div class="col-md-4">

                    <div class="text-muted small mb-1">
                        @Localizer["TotalMarks"]
                    </div>

                    <div class="fw-semibold">
                        @totalMarks
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= QUESTIONS ================= -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-1 fw-semibold">
                        <i class="bi bi-question-circle me-2"></i>
                        @Localizer["Questions"]
                    </h5>

                    <small class="text-muted">
                        @Localizer["QuestionsSubtitle"]
                    </small>

                </div>


                <a asp-area="Trainer"
                   asp-controller="Questions"
                   asp-action="Create"
                   asp-route-quizId="@Model.Id"
                   class="btn btn-primary btn-sm">

                    <i class="bi bi-plus-lg me-1"></i>
                    @Localizer["AddQuestion"]

                </a>

            </div>

        </div>


        <div class="card-body p-0">

            @if (questions.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4" style="width:70px;">
                                    #
                                </th>

                                <th>
                                    @Localizer["Question"]
                                </th>

                                <th style="width:100px;">
                                    @Localizer["Mark"]
                                </th>

                                <th style="width:170px;">
                                    @Localizer["Type"]
                                </th>

                                <th class="text-end pe-4" style="width:180px;">
                                    @Localizer["Actions"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int questionNumber = 1;
                            }

                            @foreach (var question in questions)
                            {
                                <tr>

                                    <td class="ps-4 fw-semibold">
                                        @questionNumber
                                    </td>

                                    <td>

                                        <div class="fw-semibold">
                                            @question.QuestionText
                                        </div>

                                    </td>

                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @question.Mark
                                        </span>

                                    </td>

                                    <td>

                                        @if (question.QuestionType ==
                                            QuestionType.MultipleChoice)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">
                                                @Localizer["MultipleChoice"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                @Localizer["TrueFalse"]
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-1">

                                            <!-- Details -->
                                            <a asp-area="Trainer"
                                               asp-controller="Questions"
                                               asp-action="Details"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="@Localizer["ViewDetails"]">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-area="Trainer"
                                               asp-controller="Questions"
                                               asp-action="Edit"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="@Localizer["EditQuestion"]">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-area="Trainer"
                                                  asp-controller="Questions"
                                                  asp-action="Delete"
                                                  asp-route-id="@question.Id"
                                                  asp-route-quizId="@Model.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('@Localizer["DeleteQuestionConfirm"]');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="@Localizer["DeleteQuestion"]">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                questionNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty Questions State -->

                <div class="text-center py-5">

                    <i class="bi bi-question-circle display-4 text-muted"></i>

                    <h5 class="mt-3">
                        @Localizer["NoQuestionsYet"]
                    </h5>

                    <p class="text-muted mb-4">
                        @Localizer["NoQuestionsInQuiz"]
                    </p>

                    <a asp-area="Trainer"
                       asp-controller="Questions"
                       asp-action="Create"
                       asp-route-quizId="@Model.Id"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        @Localizer["AddFirstQuestion"]

                    </a>

                </div>
            }

        </div>

    </div>


    <!-- ================= QUIZ RESULTS ================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">

            <h5 class="mb-1 fw-semibold">
                <i class="bi bi-bar-chart-line me-2"></i>
                @Localizer["QuizResults"]
            </h5>

            <small class="text-muted">
                @Localizer["ResultsSubtitle"]
            </small>

        </div>


        <div class="card-body p-0">

            @if (results.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    @Localizer["Trainee"]
                                </th>

                                <th>
                                    @Localizer["Score"]
                                </th>

                                <th>
                                    @Localizer["Status"]
                                </th>

                                <th>
                                    @Localizer["SubmittedAt"]
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var result in results)
                            {
                                <tr>

                                    <td class="ps-4">

                                        <div class="fw-semibold">
                                            @(result.User?.UserName ?? Localizer["UnknownUser"].Value)
                                        </div>

                                    </td>

                                    <td>

                                        <span class="fw-semibold">
                                            @result.Score
                                        </span>

                                    </td>

                                    <td>

                                        @if (result.IsPassed)
                                        {
                                            <span class="badge bg-success">
                                                @Localizer["Passed"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                @Localizer["Failed"]
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <span class="text-muted">
                                            @result.SubmittedAt.ToString("dd MMM yyyy, hh:mm tt")
                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Empty Results State -->

                <div class="text-center py-5">

                    <i class="bi bi-bar-chart display-4 text-muted"></i>

                    <h5 class="mt-3">
                        @Localizer["NoResultsYet"]
                    </h5>

                    <p class="text-muted mb-0">
                        @Localizer["NoTraineesSubmitted"]
                    </p>

                </div>
            }

        </div>

    </div>

</div>