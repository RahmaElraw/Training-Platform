@model Training_Platform.ViewModels.CertificateWithRelatedVM

<div class="card">

    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">@Localizer["Certificates"]</h5>
    </div>

    <div class="card-body">

        <form asp-action="Index" method="get" class="row mb-4">

            <div class="col-md-4">
                <input asp-for="Query"
                       name="query"
                       class="form-control"
                       placeholder="@Localizer["SearchByCertificateUserOrCourse"]" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100">
                    @Localizer["Search"]
                </button>
            </div>

        </form>

        <table class="table table-bordered table-hover align-middle">

            <thead class="table-light">
                <tr>
                    <th>@Localizer["CertificateNo"]</th>
                    <th>@Localizer["User"]</th>
                    <th>@Localizer["Course"]</th>
                    <th>@Localizer["IssueDate"]</th>
                    <th width="220">@Localizer["Actions"]</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Certificates.Any())
                {
                    @foreach (var item in Model.Certificates)
                    {
                        <tr>

                            <td>@item.CertificateNumber</td>

                            <td>@item.User.UserName</td>

                            <td>@item.Course.Title</td>

                            <td>@item.IssueDate.ToShortDateString()</td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    @Localizer["Details"]
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Are you sure you want to delete this certificate?');">
                                        @Localizer["Delete"]
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5" class="text-center">
                            @Localizer["NoCertificatesFound"]
                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">

        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-query="@Model.Query">
                        @i
                    </a>

                </li>
            }

        </ul>

    </nav>
}
