@model Training_Platform.ViewModels.RegisterVM

@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">Create Account</h2>
    <p class="text-muted mb-0">Join our Training Platform today</p>
</div>

<form asp-action="Register" method="post" enctype="multipart/form-data">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="text-center mb-4">
        <div class="profile-avatar mx-auto mb-2" id="previewAvatar">
            <i class="bi bi-person-fill"></i>
        </div>
        <img src="" class="profile-avatar-img mx-auto mb-2 d-none" id="previewImg" alt="Profile picture" />

        <div>
            <label for="ProfileImageFile" class="text-primary text-decoration-none fw-semibold" style="cursor: pointer; font-size: 0.85rem;">
                Add Profile Photo (optional)
            </label>
            <input type="file" asp-for="ProfileImageFile" id="ProfileImageFile" accept=".jpg,.jpeg,.png,.webp" class="d-none" onchange="previewImage(event)" />
        </div>
        <span asp-validation-for="ProfileImageFile" class="text-danger d-block"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FName" class="form-label"></label>
            <div class="input-icon">
                <i class="bi bi-person"></i>
                <input asp-for="FName" class="form-control" placeholder="First name" />
            </div>
            <span asp-validation-for="FName" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="LName" class="form-label"></label>
            <div class="input-icon">
                <i class="bi bi-person"></i>
                <input asp-for="LName" class="form-control" placeholder="Last name" />
            </div>
            <span asp-validation-for="LName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-at"></i>
            <input asp-for="Username" class="form-control" placeholder="Username" />
        </div>
        <span asp-validation-for="Username" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-telephone"></i>
            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
        </div>
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-icon">
                <i class="bi bi-lock"></i>
                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
            <div class="input-icon">
                <i class="bi bi-lock-fill"></i>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="Address" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-geo-alt"></i>
            <input asp-for="Address" class="form-control" placeholder="Your address" />
        </div>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <input type="submit" value="Register" class="btn btn-primary btn-lg" />
    </div>

    <div class="text-center mt-3">
        <span class="text-muted">Already have an account?</span>
        <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">Login</a>
    </div>

</form>

<style>
    .profile-avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4b6cff 0%, #2f3fb8 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
    }

    .profile-avatar-img {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #eceef3;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />

    <script>
        function previewImage(event) {
            const img = document.getElementById('previewImg');
            const avatar = document.getElementById('previewAvatar');
            const file = event.target.files[0];

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    if (avatar) avatar.classList.add('d-none');
                };
                reader.readAsDataURL(file);
            }
        }
    </script>
}