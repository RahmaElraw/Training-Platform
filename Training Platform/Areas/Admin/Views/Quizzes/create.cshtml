@model Training_Platform.ViewModels.QuizVM

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">Create Quiz</h5>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row">

                <!-- Title -->

                <div class="col-md-6 mb-3">

                    <label asp-for="Title"
                           class="form-label">

                        Quiz Title
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter quiz title..." />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- Course -->

                <div class="col-md-6 mb-3">

                    <label asp-for="CourseId"
                           class="form-label">

                        Course
                        <span class="text-danger">*</span>

                    </label>
                    
                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">

                        <option value="">
                            -- Select Course --
                        </option>

                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger">
                    </span>

                </div>


                <!-- Passing Score -->

                <div class="col-md-6 mb-3">

                    <label asp-for="PassingScore"
                           class="form-label">

                        Passing Score
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="PassingScore"
                           type="number"
                           min="0"
                           max="100"
                           class="form-control" />

                    <span asp-validation-for="PassingScore"
                          class="text-danger">
                    </span>

                </div>


                <!-- Time Limit -->

                <div class="col-md-6 mb-3">

                    <label asp-for="TimeLimit"
                           class="form-label">

                        Time Limit (Minutes)
                        <span class="text-danger">*</span>

                    </label>

                    <input asp-for="TimeLimit"
                           type="number"
                           min="1"
                           class="form-control" />

                    <span asp-validation-for="TimeLimit"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    Create Quiz

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}