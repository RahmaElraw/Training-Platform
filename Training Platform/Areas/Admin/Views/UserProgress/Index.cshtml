@model IEnumerable<Training_Platform.ViewModels.UserProgressVM>

@{
    ViewData["Title"] = "Users Progress";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Users Progress</h2>
            <p class="text-muted">
                Track users' progress across courses.
            </p>
        </div>
    </div>

    <form asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">
            <input type="text"
                   name="query"
                   value="@Context.Request.Query["query"]"
                   class="form-control"
                   placeholder="Search by user or course..." />

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>
        </div>

    </form>


    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No progress data found.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>User</th>
                                <th>Course</th>
                                <th>Completed Lessons</th>
                                <th>Progress</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @item.UserName
                                        </strong>
                                    </td>

                                    <td>
                                        @item.CourseTitle
                                    </td>

                                    <td>
                                        @item.CompletedLessons
                                        /
                                        @item.TotalLessons
                                    </td>

                                    <td style="min-width: 200px;">

                                        <div class="d-flex align-items-center gap-2">

                                            <div class="progress flex-grow-1"
                                                 style="height: 10px;">

                                                <div class="progress-bar"
                                                     role="progressbar"
                                                     style="width: @item.ProgressPercentage%;"
                                                     aria-valuenow="@item.ProgressPercentage"
                                                     aria-valuemin="0"
                                                     aria-valuemax="100">
                                                </div>

                                            </div>

                                            <span>
                                                @item.ProgressPercentage%
                                            </span>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>