@model Training_Platform.ViewModels.TakeQuizViewModel

<h2>@Model.QuizTitle</h2>

<form asp-controller="Quiz"
      asp-action="Submit"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="QuizId"
           value="@Model.QuizId" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        var question = Model.Questions[i];

        <div class="mb-4">

            <h4>
                @(i + 1). @question.QuestionText
            </h4>

            <input type="hidden"
                   name="Answers[@i].QuestionId"
                   value="@question.QuestionId" />

            @foreach (var option in question.Options)
            {
                <div>
                    <input type="radio"
                           name="Answers[@i].SelectedOptionId"
                           value="@option.Id"
                           required />

                    <label>
                        @option.OptionText
                    </label>
                </div>
            }

        </div>
    }

    <button type="submit" class="btn btn-primary">
        @Localizer["SubmitQuiz"]
    </button>

</form>