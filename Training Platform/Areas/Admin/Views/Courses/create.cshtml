@model Training_Platform.ViewModels.CourseVM

<div class="card-header">
    <h5 class="mb-0">
        Create New Course
    </h5>
</div>

<div class="card-body bg-light">

    <form asp-action="Create" method="post" class="row gx-3">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>


        <!-- Course Title -->
        <div class="col-md-6 mb-3">

            <label asp-for="Title" class="form-label">
                Course Title
                <span class="text-danger">*</span>
            </label>

            <input asp-for="Title"
                   class="form-control"
                   placeholder="Enter course title" />

            <span asp-validation-for="Title"
                  class="text-danger"></span>

        </div>


        <!-- Duration -->
        <div class="col-md-6 mb-3">

            <label asp-for="DurationInHours" class="form-label">
                Duration (Hours)
                <span class="text-danger">*</span>
            </label>

            <input asp-for="DurationInHours"
                   type="number"
                   min="1"
                   class="form-control"
                   placeholder="Enter duration in hours" />

            <span asp-validation-for="DurationInHours"
                  class="text-danger"></span>

        </div>


        <!-- Category -->
        <div class="col-md-6 mb-3">

            <label asp-for="CategoryId" class="form-label">
                Category
                <span class="text-danger">*</span>
            </label>

            <select asp-for="CategoryId"
                    asp-items="ViewBag.Categories"
                    class="form-select">

                <option value="">
                    -- Select Category --
                </option>

            </select>

            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>

        </div>


        <!-- Trainer -->
        <div class="col-md-6 mb-3">

            <label asp-for="TrainerId" class="form-label">
                Trainer
                <span class="text-danger">*</span>
            </label>

            <select asp-for="TrainerId"
                    asp-items="ViewBag.Trainers"
                    class="form-select">

                <option value="">
                    -- Select Trainer --
                </option>

            </select>

            <span asp-validation-for="TrainerId"
                  class="text-danger"></span>

        </div>


        <!-- Level -->
        <div class="col-md-6 mb-3">

            <label asp-for="Level" class="form-label">
                Course Level
                <span class="text-danger">*</span>
            </label>

            <select asp-for="Level"
                    asp-items="Html.GetEnumSelectList<Training_Platform.Models.CourseLevel>()"
                    class="form-select">

                <option value="">
                    -- Select Level --
                </option>

            </select>

            <span asp-validation-for="Level"
                  class="text-danger"></span>

        </div>


        <!-- Thumbnail -->
        <div class="col-md-6 mb-3">

            <label asp-for="Thumbnail" class="form-label">
                Thumbnail URL
            </label>

            <input asp-for="Thumbnail"
                   class="form-control"
                   placeholder="Enter thumbnail URL" />

            <span asp-validation-for="Thumbnail"
                  class="text-danger"></span>

        </div>


        <!-- Description -->
        <div class="col-12 mb-3">

            <label asp-for="Description" class="form-label">
                Description
                <span class="text-danger">*</span>
            </label>

            <textarea asp-for="Description"
                      rows="5"
                      class="form-control"
                      placeholder="Enter course description"></textarea>

            <span asp-validation-for="Description"
                  class="text-danger"></span>

        </div>


        <!-- Is Published -->
        <div class="col-12 mb-3">

            <div class="form-check">

                <input asp-for="IsPublished"
                       class="form-check-input"
                       type="checkbox" />

                <label asp-for="IsPublished"
                       class="form-check-label">

                    Publish Course

                </label>

            </div>

        </div>


        <!-- Buttons -->
        <div class="col-12 d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>

                Back

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="fas fa-save me-1"></i>

                Create Course

            </button>

        </div>

    </form>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}