@using Training_Platform.Models
@model IEnumerable<Lesson>

@{
    ViewData["Title"] = "Course Lessons";
    Layout = "~/Areas/Trainer/Views/Shared/_TrainerLayout.cshtml";
}


<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Course Lessons</h2>

            <p class="text-muted mb-0">
                Manage lessons for
                <strong>@ViewBag.Course.Title</strong>
            </p>
        </div>

        <a asp-action="Create"
           asp-route-courseId="@ViewBag.Course.Id"
           class="btn btn-primary">

            <i class="bi bi-plus-lg"></i>
            Add Lesson

        </a>

    </div>


    <!-- Lessons Table -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Lessons
            </h5>

        </div>

        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>

                                <th>#</th>

                                <th>Title</th>

                                <th>Description</th>

                                <th>Order</th>

                                <th>Video</th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var lesson in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @lesson.OrderNumber
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @lesson.Title
                                        </div>
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(lesson.Description))
                                        {
                                            @(lesson.Description.Length > 60
                                                ? lesson.Description.Substring(0, 60) + "..."
                                                : lesson.Description)
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No description
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @lesson.OrderNumber
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(lesson.VideoUrl))
                                        {
                                            <a href="@lesson.VideoUrl"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-info">

                                                <i class="bi bi-play-circle"></i>
                                                Watch

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No video
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@lesson.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@lesson.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@lesson.Id"
                                                  asp-route-courseId="@lesson.CourseId"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this lesson? Related materials and progress will also be deleted.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-journal-x fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No lessons found
                    </h5>

                    <p class="text-muted">
                        This course doesn't have any lessons yet.
                    </p>

                    <a asp-action="Create"
                       asp-route-courseId="@ViewBag.Course.Id"
                       class="btn btn-primary">

                        <i class="bi bi-plus-lg"></i>
                        Create First Lesson

                    </a>

                </div>
            }

        </div>

    </div>

</div>