@model Training_Platform.ViewModels.ForgotPasswordVM

@{
    ViewData["Title"] = Localizer["ForgetPassword"];
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">@Localizer["ForgetPassword"]</h2>
    <p class="text-muted mb-0">@Localizer["EnterEmailToReceiveCode"]</p>
</div>

<form asp-action="ForgetPassword" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-4">
        <label asp-for="Email" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-envelope"></i>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" type="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <input type="submit" value="@Localizer["SendCode"]" class="btn btn-primary btn-lg" />
    </div>

    <div class="text-center mt-3">
        <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">@Localizer["BackToLogin"]</a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}