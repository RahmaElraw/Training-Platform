    <style>
            #navbarVerticalNav .nav-link {
                border-radius: 8px !important;
                margin: 4px 10px !important;
                padding: 10px 15px !important;
                transition: all 0.3s ease !important;
                color: #5e6e82;
                font-weight: 500;
            }

                #navbarVerticalNav .nav-link:hover {
                    background-color: rgba(44, 123, 229, 0.1) !important;
                    color: #2c7be5 !important;
                    transform: translateX(5px);
                }

                #navbarVerticalNav .nav-link.active {
                    background-color: #2c7be5 !important;
                    color: #ffffff !important;
                    box-shadow: 0 4px 10px rgba(44, 123, 229, 0.3) !important;
                    font-weight: 600;
                }

                    #navbarVerticalNav .nav-link.active .nav-link-text,
                    #navbarVerticalNav .nav-link.active .nav-link-icon {
                        color: #ffffff !important;
                    }
    </style>

    <script>
            var isRTL = JSON.parse(localStorage.getItem('isRTL'));
            if (isRTL) {
                var linkDefault = document.getElementById('style-default');
                var userLinkDefault = document.getElementById('user-style-default');
                linkDefault.setAttribute('disabled', true);
                userLinkDefault.setAttribute('disabled', true);
                document.querySelector('html').setAttribute('dir', 'rtl');
            } else {
                var linkRTL = document.getElementById('style-rtl');
                var userLinkRTL = document.getElementById('user-style-rtl');
                linkRTL.setAttribute('disabled', true);
                userLinkRTL.setAttribute('disabled', true);
            }
    </script>
