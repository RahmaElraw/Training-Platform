@model IEnumerable<Training_Platform.Models.Quiz>

@{
    ViewData["Title"] = "My Quizzes";

    var quizzes = Model?.ToList() ?? new List<Training_Platform.Models.Quiz>();

    var totalQuizzes = quizzes.Count;
    var totalQuestions = quizzes.Sum(q => q.Questions?.Count ?? 0);
    var quizzesWithQuestions = quizzes.Count(q => (q.Questions?.Count ?? 0) > 0);
    var quizzesWithoutQuestions = totalQuizzes - quizzesWithQuestions;

    var courses = quizzes
        .Where(q => q.Course != null)
        .Select(q => q.Course!.Title)
        .Distinct()
        .OrderBy(x => x)
        .ToList();
}

<div class="container-fluid">

    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="bg-primary bg-opacity-10 rounded-3 p-2">
                    <i class="bi bi-question-circle text-primary fs-4"></i>
                </div>

                <h2 class="fw-bold mb-0">
                    My Quizzes
                </h2>

            </div>

            <p class="text-muted mb-0">
                Manage and review quizzes belonging to your courses.
            </p>
        </div>


        <!-- Create Quiz -->
        <div class="mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn btn-primary px-4">

                <i class="bi bi-plus-lg me-1"></i>
                Create Quiz

            </a>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TEMP DATA MESSAGES -->
    <!-- ===================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-circle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ===================================================== -->
    <!-- STATISTICS -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total Quizzes -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Total Quizzes
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                @totalQuizzes
                            </h3>

                        </div>

                        <div class="bg-primary bg-opacity-10 rounded-3 p-3">

                            <i class="bi bi-question-circle text-primary fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Questions -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Total Questions
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                @totalQuestions
                            </h3>

                        </div>

                        <div class="bg-info bg-opacity-10 rounded-3 p-3">

                            <i class="bi bi-list-check text-info fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Ready Quizzes -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Ready Quizzes
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                @quizzesWithQuestions
                            </h3>

                        </div>

                        <div class="bg-success bg-opacity-10 rounded-3 p-3">

                            <i class="bi bi-check-circle text-success fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Need Questions -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <small class="text-muted">
                                Need Questions
                            </small>

                            <h3 class="fw-bold mb-0 mt-1">
                                @quizzesWithoutQuestions
                            </h3>

                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-3 p-3">

                            <i class="bi bi-exclamation-triangle text-warning fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SEARCH & FILTERS -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <!-- Search -->
                <div class="col-lg-5">

                    <label class="form-label fw-semibold">
                        Search
                    </label>

                    <div class="input-group">

                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="quizSearch"
                               class="form-control"
                               placeholder="Search by quiz or course..." />

                    </div>

                </div>


                <!-- Course Filter -->
                <div class="col-lg-3">

                    <label class="form-label fw-semibold">
                        Course
                    </label>

                    <select id="courseFilter"
                            class="form-select">

                        <option value="">
                            All Courses
                        </option>

                        @foreach (var course in courses)
                        {
                            <option value="@course">
                                @course
                            </option>
                        }

                    </select>

                </div>


                <!-- Status Filter -->
                <div class="col-lg-2">

                    <label class="form-label fw-semibold">
                        Status
                    </label>

                    <select id="statusFilter"
                            class="form-select">

                        <option value="">
                            All
                        </option>

                        <option value="ready">
                            Ready
                        </option>

                        <option value="empty">
                            No Questions
                        </option>

                    </select>

                </div>


                <!-- Reset -->
                <div class="col-lg-2">

                    <button type="button"
                            id="resetFilters"
                            class="btn btn-outline-secondary w-100">

                        <i class="bi bi-arrow-counterclockwise me-1"></i>
                        Reset

                    </button>

                </div>

            </div>


            <!-- Results Counter -->

            <div class="d-flex justify-content-between align-items-center mt-3">

                <small class="text-muted">

                    Showing
                    <strong id="visibleCount">
                        @totalQuizzes
                    </strong>
                    quiz(es)

                </small>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- QUIZZES TABLE -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-collection me-2"></i>
                        All Quizzes
                    </h5>

                    <small class="text-muted">
                        Select a quiz to view its questions and results.
                    </small>

                </div>

                <span class="badge bg-primary"
                      id="totalBadge">

                    @totalQuizzes

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (quizzes.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0"
                           id="quizzesTable">

                        <thead class="table-light">

                            <tr>

                                <th class="ps-4">
                                    #
                                </th>

                                <th>
                                    Quiz
                                </th>

                                <th>
                                    Course
                                </th>

                                <th class="text-center">
                                    Questions
                                </th>

                                <th class="text-center">
                                    Passing Score
                                </th>

                                <th class="text-center">
                                    Time Limit
                                </th>

                                <th class="text-center">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var quiz in quizzes)
                            {
                                var questionCount =
                                    quiz.Questions?.Count ?? 0;

                                var isReady =
                                    questionCount > 0;

                                var courseTitle =
                                    quiz.Course?.Title ?? "N/A";

                                <tr class="quiz-row"
                                    data-quiz="@quiz.Title.ToLower()"
                                    data-course="@courseTitle.ToLower()"
                                    data-status="@(isReady ? "ready" : "empty")">

                                    <!-- Number -->
                                    <td class="ps-4 text-muted">
                                        @counter
                                    </td>


                                    <!-- Quiz -->
                                    <td>

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="bg-primary bg-opacity-10 rounded-3 p-2">

                                                <i class="bi bi-question-lg text-primary"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold">
                                                    @quiz.Title
                                                </div>

                                                @if (isReady)
                                                {
                                                    <small class="text-success">

                                                        <i class="bi bi-check-circle me-1"></i>
                                                        Ready

                                                    </small>
                                                }
                                                else
                                                {
                                                    <small class="text-warning">

                                                        <i class="bi bi-exclamation-triangle me-1"></i>
                                                        No questions yet

                                                    </small>
                                                }

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Course -->
                                    <td>

                                        @if (quiz.Course != null)
                                        {
                                            <span class="badge bg-light text-dark border">

                                                <i class="bi bi-book me-1"></i>

                                                @quiz.Course.Title

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <!-- Questions -->
                                    <td class="text-center">

                                        <span class="badge rounded-pill
                                            @(questionCount > 0
                                                ? "bg-primary"
                                                : "bg-secondary")">

                                            @questionCount

                                        </span>

                                    </td>


                                    <!-- Passing Score -->
                                    <td class="text-center">

                                        <span class="fw-semibold">
                                            @quiz.PassingScore%
                                        </span>

                                    </td>


                                    <!-- Time Limit -->
                                    <td class="text-center">

                                        @if (quiz.TimeLimit > 0)
                                        {
                                            <span class="text-nowrap">

                                                <i class="bi bi-clock me-1 text-muted"></i>

                                                @quiz.TimeLimit min

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No limit
                                            </span>
                                        }

                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="d-flex justify-content-center gap-1">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@quiz.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit Quiz">

                                                <i class="bi bi-pencil"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@quiz.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this quiz? All related questions, options, and quiz results will also be deleted.');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete Quiz">

                                                    <i class="bi bi-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                    </table>

                </div>


                <!-- No Search Results -->
                <div id="noSearchResults"
                     class="text-center py-5 d-none">

                    <i class="bi bi-search fs-1 text-muted"></i>

                    <h5 class="fw-bold mt-3">
                        No quizzes found
                    </h5>

                    <p class="text-muted mb-0">
                        Try changing your search or filters.
                    </p>

                </div>

            }
            else
            {
                <!-- ================================================= -->
                <!-- EMPTY STATE -->
                <!-- ================================================= -->

                <div class="text-center py-5">

                    <div class="mb-3">

                        <i class="bi bi-question-circle fs-1 text-muted"></i>

                    </div>

                    <h4 class="fw-bold">
                        No Quizzes Found
                    </h4>

                    <p class="text-muted mb-4">
                        You haven't created any quizzes yet.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary px-4">

                        <i class="bi bi-plus-lg me-1"></i>
                        Create Your First Quiz

                    </a>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput =
                document.getElementById("quizSearch");

            const courseFilter =
                document.getElementById("courseFilter");

            const statusFilter =
                document.getElementById("statusFilter");

            const resetButton =
                document.getElementById("resetFilters");

            const rows =
                document.querySelectorAll(".quiz-row");

            const visibleCount =
                document.getElementById("visibleCount");

            const noSearchResults =
                document.getElementById("noSearchResults");


            function filterQuizzes() {

                const searchValue =
                    searchInput.value
                        .toLowerCase()
                        .trim();

                const selectedCourse =
                    courseFilter.value
                        .toLowerCase()
                        .trim();

                const selectedStatus =
                    statusFilter.value
                        .toLowerCase()
                        .trim();


                let count = 0;


                rows.forEach(function(row) {

                    const quizName =
                        row.dataset.quiz || "";

                    const courseName =
                        row.dataset.course || "";

                    const status =
                        row.dataset.status || "";


                    const matchesSearch =
                        quizName.includes(searchValue) ||
                        courseName.includes(searchValue);


                    const matchesCourse =
                        selectedCourse === "" ||
                        courseName === selectedCourse;


                    const matchesStatus =
                        selectedStatus === "" ||
                        status === selectedStatus;


                    const shouldShow =
                        matchesSearch &&
                        matchesCourse &&
                        matchesStatus;


                    if (shouldShow) {

                        row.classList.remove("d-none");

                        count++;

                    }
                    else {

                        row.classList.add("d-none");

                    }

                });


                visibleCount.textContent = count;


                if (noSearchResults) {

                    if (count === 0 && rows.length > 0) {

                        noSearchResults.classList.remove("d-none");

                    }
                    else {

                        noSearchResults.classList.add("d-none");

                    }

                }

            }


            // Search
            searchInput?.addEventListener(
                "input",
                filterQuizzes
            );


            // Course filter
            courseFilter?.addEventListener(
                "change",
                filterQuizzes
            );


            // Status filter
            statusFilter?.addEventListener(
                "change",
                filterQuizzes
            );


            // Reset
            resetButton?.addEventListener(
                "click",
                function() {

                    searchInput.value = "";

                    courseFilter.value = "";

                    statusFilter.value = "";

                    filterQuizzes();

                }
            );

        });

    </script>
}