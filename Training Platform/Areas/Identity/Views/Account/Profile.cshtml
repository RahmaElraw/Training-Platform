@model Training_Platform.ViewModels.ProfileVM

@{
    ViewData["Title"] = Localizer["Profile"];
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    @if (!string.IsNullOrEmpty(Model.ProfileImage))
    {
        <img src="~/images/profiles/@Model.ProfileImage" class="profile-avatar-img mx-auto mb-3" alt="@Localizer["ProfilePicture"]" />
    }
    else
    {
        <div class="profile-avatar mx-auto mb-3">
            @($"{Model.FirstName?.FirstOrDefault()}{Model.LastName?.FirstOrDefault()}".ToUpper())
        </div>
    }
    <h2 class="fw-bold mb-0">@Model.FirstName @Model.LastName</h2>
    <p class="text-muted">@@@Model.Username</p>
</div>

<div class="profile-info-card mb-4">
    <div class="profile-info-row">
        <div class="profile-info-icon">
            <i class="bi bi-envelope"></i>
        </div>
        <div>
            <div class="profile-info-label">@Localizer["Email"]</div>
            <div class="profile-info-value">@Model.Email</div>
        </div>
    </div>

    <div class="profile-info-row">
        <div class="profile-info-icon">
            <i class="bi bi-telephone"></i>
        </div>
        <div>
            <div class="profile-info-label">@Localizer["PhoneNumber"]</div>
            <div class="profile-info-value">@Model.PhoneNumber</div>
        </div>
    </div>

    <div class="profile-info-row">
        <div class="profile-info-icon">
            <i class="bi bi-geo-alt"></i>
        </div>
        <div>
            <div class="profile-info-label">@Localizer["Address"]</div>
            <div class="profile-info-value">@Model.Address</div>
        </div>
    </div>
</div>

<div class="d-grid gap-2 mb-3">
    <a asp-action="EditProfile" class="settings-pill settings-pill-blue">
        <i class="bi bi-pencil"></i> @Localizer["EditProfile"]
    </a>

    <a asp-action="ChangePassword" class="settings-pill settings-pill-purple">
        <i class="bi bi-key"></i> @Localizer["ChangePassword"]
    </a>

    <form asp-action="Logout" method="post" class="m-0">
        <button type="submit" class="settings-pill settings-pill-red w-100 border-0">
            <i class="bi bi-box-arrow-right"></i> @Localizer["Logout"]
        </button>
    </form>
</div>

<style>
    .profile-avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4b6cff 0%, #2f3fb8 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .profile-avatar-img {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #eceef3;
    }

    .profile-info-card {
        background: #f8f9fc;
        border-radius: 12px;
        padding: 8px 16px;
    }

    .profile-info-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 0;
        border-bottom: 1px solid #e9ecf5;
    }

        .profile-info-row:last-child {
            border-bottom: none;
        }

    .profile-info-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: #e8ecff;
        color: #4b6cff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .profile-info-label {
        font-size: 0.75rem;
        color: #9aa3b5;
        margin-bottom: 1px;
    }

    .profile-info-value {
        font-size: 0.92rem;
        color: #1f2430;
        font-weight: 500;
    }

    .settings-pill {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        text-align: center;
    }

    .settings-pill-blue {
        background: #eaf0ff;
        color: #3a56db;
    }

        .settings-pill-blue:hover {
            background: #dde7ff;
            color: #3a56db;
        }

    .settings-pill-purple {
        background: #f2ecfe;
        color: #7c4de0;
    }

        .settings-pill-purple:hover {
            background: #e9defd;
            color: #7c4de0;
        }

    .settings-pill-red {
        background: #fdeeee;
        color: #d84b4b;
    }

        .settings-pill-red:hover {
            background: #fbe0e0;
            color: #d84b4b;
        }
</style>

@section Scripts {
    <partial name="_NotificationPartial" />
}