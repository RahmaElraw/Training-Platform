@model Training_Platform.Models.Lesson

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            @Localizer["LessonDetails"]
        </h5>

        <a asp-action="Index"
           class="btn btn-secondary btn-sm">

            <i class="fas fa-arrow-left me-1"></i>
            @Localizer["Back"]

        </a>

    </div>


    <div class="card-body">

        <h3>
            @Model.Title
        </h3>

        <p class="text-muted">
            @(Model.Description ?? Localizer["NoDescription"].Value)
        </p>


        <div class="row mt-4">

            <div class="col-md-6">

                <p>
                    <strong>@Localizer["Course"]</strong>
                    @(Model.Course?.Title ?? Localizer["NoCourse"].Value)
                </p>

                <p>
                    <strong>@Localizer["OrderNumber"]</strong>
                    @Model.OrderNumber
                </p>

            </div>

            <div class="col-md-6">

                <p>
                    <strong>@Localizer["Materials"]</strong>
                    @Model.CourseMaterials.Count
                </p>

                <p>
                    <strong>@Localizer["ProgressRecords"]</strong>
                    @Model.UserProgresses.Count
                </p>

            </div>

        </div>


        <div class="mt-3">

            <strong>@Localizer["Video"]</strong>

            <div class="mt-2">

                <a href="@Model.VideoUrl"
                   target="_blank"
                   class="btn btn-primary">

                    <i class="fas fa-video me-1"></i>
                    @Localizer["WatchVideo"]

                </a>

            </div>

        </div>
        <hr class="my-4" />

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="mb-0">
                @Localizer["CourseMaterials"]
            </h5>

        </div>


        @if (Model.CourseMaterials.Any())
        {
            <div class="list-group mb-4">

                @foreach (var material in Model.CourseMaterials)
                {
                    <div class="list-group-item">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <h6 class="mb-1">
                                    @material.Title
                                </h6>

                                <a href="@material.Url"
                                   target="_blank"
                                   class="text-primary">

                                    <i class="fas fa-external-link-alt me-1"></i>
                                    @Localizer["OpenMaterial"]

                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <div class="alert alert-info">
                @Localizer["NoCourseMaterialsYet"]
            </div>
        }

        <div class="mt-4">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-edit me-1"></i>
                @Localizer["Edit"]

            </a>

        </div>

    </div>

</div>
