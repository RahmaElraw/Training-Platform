@model Training_Platform.ViewModels.CertificateVM

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold text-dark">
                    <i class="fas fa-link text-primary me-2"></i>
                    @(string.IsNullOrWhiteSpace(Model.CertificateUrl) ? Localizer["AddCertificateLink"] : Localizer["EditCertificateLink"])
                </h5>
            </div>

            <div class="card-body p-4">

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <!-- Readonly Info Summary -->
                    <div class="mb-3 p-3 bg-light rounded border">
                        <div class="row g-2 text-sm">
                            <div class="col-6">
                                <small class="text-muted d-block">@Localizer["CertificateNo"]</small>
                                <span class="fw-bold">@Model.CertificateNumber</span>
                            </div>
                            <div class="col-6">
                                <small class="text-muted d-block">@Localizer["IssueDate"]</small>
                                <span>@Model.IssueDate.ToString("dd MMM yyyy")</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CertificateNumber" class="form-label fw-semibold">
                            @Localizer["CertificateNumber"]
                        </label>
                        <input asp-for="CertificateNumber" class="form-control" readonly />
                    </div>

                    <div class="mb-4">
                        <label asp-for="CertificateUrl" class="form-label fw-semibold">
                            @Localizer["GoogleDriveUrl"]
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fab fa-google-drive"></i></span>
                            <input asp-for="CertificateUrl"
                                   class="form-control"
                                   placeholder="https://drive.google.com/file/d/..." />
                        </div>
                        <span asp-validation-for="CertificateUrl" class="text-danger small"></span>
                        <div class="form-text">
                            @Localizer["UrlHelpText"]
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i> @Localizer["SaveCertificateLink"]
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                            @Localizer["Cancel"]
                        </a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}