@model IEnumerable<QuizResultViewModel>

@{
    ViewData["Title"] = Localizer["MyQuizResults"];
}

<div class="container mt-4">

    <h2 class="mb-4">
        @Localizer["MyQuizResults"]
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            @Localizer["NoQuizzesYet"]
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>@Localizer["Quiz"]</th>
                        <th>@Localizer["Score"]</th>
                        <th>@Localizer["Status"]</th>
                        <th>@Localizer["SubmittedAt"]</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>
                                @result.QuizTitle
                            </td>

                            <td>
                                @result.Score%
                            </td>

                            <td>
                                @if (result.IsPassed)
                                {
                                    <span class="badge bg-success">
                                        @Localizer["Passed"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        @Localizer["Failed"]
                                    </span>
                                }
                            </td>

                            <td>
                                @result.SubmittedAt.ToLocalTime()
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>