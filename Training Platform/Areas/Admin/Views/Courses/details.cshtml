@model Training_Platform.Models.Course

<div class="card">

    <!-- Header -->
    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            Course Details
        </h5>

        <span class="badge @(Model.IsPublished ? "bg-success" : "bg-secondary")">
            @(Model.IsPublished ? "Published" : "Draft")
        </span>

    </div>


    <div class="card-body bg-light">

        <div class="row">

            <!-- Thumbnail -->
            <div class="col-md-4 mb-4">

                @if (!string.IsNullOrWhiteSpace(Model.Thumbnail))
                {
                    <img src="@Model.Thumbnail"
                         alt="@Model.Title"
                         class="img-fluid rounded shadow-sm"
                         style="width: 100%; max-height: 250px; object-fit: cover;" />
                }
                else
                {
                    <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center"
                         style="height: 250px;">

                        <i class="fas fa-book fa-4x"></i>

                    </div>
                }

            </div>


            <!-- Basic Information -->
            <div class="col-md-8">

                <h3 class="mb-3">
                    @Model.Title
                </h3>

                <p class="text-muted">
                    @Model.Description
                </p>


                <div class="row mt-4">

                    <!-- Category -->
                    <div class="col-md-6 mb-3">

                        <strong>
                            <i class="fas fa-folder me-1"></i>
                            Category
                        </strong>

                        <div class="mt-1">
                            @Model.Category?.Name
                        </div>

                    </div>


                    <!-- Trainer -->
                    <div class="col-md-6 mb-3">

                        <strong>
                            <i class="fas fa-user-tie me-1"></i>
                            Trainer
                        </strong>

                        <div class="mt-1">
                            @Model.Trainer?.UserName
                        </div>

                    </div>


                    <!-- Level -->
                    <div class="col-md-6 mb-3">

                        <strong>
                            <i class="fas fa-layer-group me-1"></i>
                            Level
                        </strong>

                        <div class="mt-1">

                            @switch (Model.Level)
                            {
                                case Training_Platform.Models.CourseLevel.Beginner:

                                    <span class="badge bg-success">
                                        Beginner
                                    </span>

                                    break;

                                case Training_Platform.Models.CourseLevel.Intermediate:

                                    <span class="badge bg-warning text-dark">
                                        Intermediate
                                    </span>

                                    break;

                                case Training_Platform.Models.CourseLevel.Advanced:

                                    <span class="badge bg-danger">
                                        Advanced
                                    </span>

                                    break;
                            }

                        </div>

                    </div>


                    <!-- Duration -->
                    <div class="col-md-6 mb-3">

                        <strong>
                            <i class="fas fa-clock me-1"></i>
                            Duration
                        </strong>

                        <div class="mt-1">
                            @Model.DurationInHours hours
                        </div>

                    </div>


                    <!-- Created At -->
                    <div class="col-md-6 mb-3">

                        <strong>
                            <i class="fas fa-calendar me-1"></i>
                            Created At
                        </strong>

                        <div class="mt-1">
                            @Model.CreatedAt.ToString("dd/MM/yyyy")
                        </div>

                    </div>


                    <!-- Course ID -->
                    <div class="col-md-6 mb-3">

                        <strong>
                            <i class="fas fa-hashtag me-1"></i>
                            Course ID
                        </strong>

                        <div class="mt-1">
                            @Model.Id
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <hr class="my-4" />


        <!-- Statistics -->
        <div class="row text-center">

            <!-- Lessons -->
            <div class="col-md-3 mb-3">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <i class="fas fa-book-open fa-2x text-primary mb-2"></i>

                        <h4>
                            @(Model.Lessons?.Count ?? 0)
                        </h4>

                        <p class="text-muted mb-0">
                            Lessons
                        </p>

                    </div>

                </div>

            </div>


            <!-- Quizzes -->
            <div class="col-md-3 mb-3">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <i class="fas fa-question-circle fa-2x text-warning mb-2"></i>

                        <h4>
                            @(Model.Quizzes?.Count ?? 0)
                        </h4>

                        <p class="text-muted mb-0">
                            Quizzes
                        </p>

                    </div>

                </div>

            </div>


            <!-- Enrollments -->
            <div class="col-md-3 mb-3">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <i class="fas fa-users fa-2x text-success mb-2"></i>

                        <h4>
                            @(Model.Enrollments?.Count ?? 0)
                        </h4>

                        <p class="text-muted mb-0">
                            Enrollments
                        </p>

                    </div>

                </div>

            </div>


            <!-- Reviews -->
            <div class="col-md-3 mb-3">

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <i class="fas fa-star fa-2x text-danger mb-2"></i>

                        <h4>
                            @(Model.Reviews?.Count ?? 0)
                        </h4>

                        <p class="text-muted mb-0">
                            Reviews
                        </p>

                    </div>

                </div>

            </div>

        </div>


        <!-- Buttons -->
        <div class="d-flex justify-content-end gap-2 mt-4">

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>
                Back

            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="fas fa-edit me-1"></i>
                Edit Course

            </a>

        </div>

    </div>

</div>


@section Scripts
{
}