@model Training_Platform.ViewModels.QuizVM

@{
    ViewData["Title"] = "Create Quiz";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-plus-circle me-2"></i>
                Create Quiz
            </h2>

            <p class="text-muted mb-0">
                Create a new quiz for one of your courses.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Quizzes
        </a>
    </div>


    <!-- Create Quiz Card -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-clipboard-plus me-2"></i>
                Quiz Information
            </h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="row">

                    <!-- Course -->
                    <div class="col-md-12 mb-4">

                        <label asp-for="CourseId"
                               class="form-label fw-semibold">
                            Course
                        </label>

                        <select asp-for="CourseId"
                                asp-items="ViewBag.Courses"
                                class="form-select">

                            <option value="">
                                -- Select Course --
                            </option>

                        </select>

                        <span asp-validation-for="CourseId"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Select the course that this quiz belongs to.
                        </small>

                    </div>


                    <!-- Title -->
                    <div class="col-md-12 mb-4">

                        <label asp-for="Title"
                               class="form-label fw-semibold">
                            Quiz Title
                        </label>

                        <input asp-for="Title"
                               class="form-control"
                               placeholder="Enter quiz title..." />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Passing Score -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="PassingScore"
                               class="form-label fw-semibold">
                            Passing Score
                        </label>

                        <div class="input-group">

                            <input asp-for="PassingScore"
                                   type="number"
                                   class="form-control"
                                   min="0"
                                   max="100"
                                   placeholder="e.g. 60" />

                            <span class="input-group-text">
                                %
                            </span>

                        </div>

                        <span asp-validation-for="PassingScore"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Minimum score required to pass the quiz.
                        </small>

                    </div>


                    <!-- Time Limit -->
                    <div class="col-md-6 mb-4">

                        <label asp-for="TimeLimit"
                               class="form-label fw-semibold">
                            Time Limit
                        </label>

                        <div class="input-group">

                            <input asp-for="TimeLimit"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   max="300"
                                   placeholder="e.g. 30" />

                            <span class="input-group-text">
                                Minutes
                            </span>

                        </div>

                        <span asp-validation-for="TimeLimit"
                              class="text-danger">
                        </span>

                        <small class="text-muted">
                            Maximum time allowed to complete the quiz.
                        </small>

                    </div>

                </div>


                <!-- Actions -->
                <div class="d-flex gap-2 pt-3 border-top">

                    <button type="submit"
                            class="btn btn-primary px-4">

                        <i class="bi bi-check-lg me-1"></i>
                        Create Quiz

                    </button>


                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        <i class="bi bi-x-lg me-1"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}