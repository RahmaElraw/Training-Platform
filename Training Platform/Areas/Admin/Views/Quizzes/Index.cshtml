@model Training_Platform.ViewModels.QuizWithRelatedVM

<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            @Localizer["AllQuizzes"]
        </h5>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="fas fa-plus me-1"></i>
            @Localizer["AddQuiz"]

        </a>

    </div>


    <div class="card-body">

        <form method="get">

            <div class="input-group">

                <input asp-for="Query"
                       name="query"
                       class="form-control"
                       placeholder="@Localizer["SearchQuizOrCourse"]" />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-search"></i>

                </button>

            </div>

        </form>

    </div>

</div>


@if (!Model.Quizzes.Any())
{
    <div class="alert alert-warning">
        @Localizer["NoQuizzesFound"]
    </div>
}


@foreach (var item in Model.Quizzes)
{
    <article class="card mb-3 shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-9">

                    <h4>
                        @item.Title
                    </h4>

                    <p class="text-muted">

                        <strong>@Localizer["Course"]:</strong>

                        @(item.Course?.Title ?? Localizer["NoCourse"].Value)

                    </p>


                    <div class="d-flex flex-wrap gap-4">

                        <span>

                            <strong>@Localizer["PassingScore"]:</strong>

                            @item.PassingScore%

                        </span>


                        <span>

                            <strong>@Localizer["TimeLimit"]:</strong>

                            @item.TimeLimit @Localizer["Minutes"]

                        </span>


                        <span>

                            <strong>@Localizer["Questions"]:</strong>

                            @item.Questions.Count

                        </span>


                        <span>

                            <strong>@Localizer["Results"]:</strong>

                            @item.QuizResults.Count

                        </span>

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="d-grid gap-2">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info text-white">

                            <i class="fas fa-eye me-1"></i>
                            @Localizer["Details"]

                        </a>


                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-primary">

                            <i class="fas fa-edit me-1"></i>
                            @Localizer["Edit"]

                        </a>


                        <form asp-action="Delete"
                              asp-route-id="@item.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-danger w-100"
                                    onclick="return confirm('Are you sure you want to delete this quiz?');">

                                <i class="fas fa-trash-alt me-1"></i>
                                @Localizer["Delete"]

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </article>
}


@if (Model.TotalPages > 1)
{
    <nav>

        <ul class="pagination justify-content-center">

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item
                    @(i == Model.CurrentPage ? "active" : "")">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-query="@Model.Query">

                        @i

                    </a>

                </li>
            }

        </ul>

    </nav>
}