@model Training_Platform.Models.Certificate

@{
    ViewData["Title"] = "Certificate Details";
}

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">Certificate Details</h5>
    </div>

    <div class="card-body">

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Certificate Number
            </div>

            <div class="col-md-9">
                @Model.CertificateNumber
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                User
            </div>

            <div class="col-md-9">
                @Model.User.UserName
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Email
            </div>

            <div class="col-md-9">
                @Model.User.Email
            </div>
        </div>

        <hr />

        <div class="row mb-3">
            <div class="col-md-3 fw-bold">
                Course
            </div>

            <div class="col-md-9">
                @Model.Course.Title
            </div>
        </div>

        <hr />

        <div class="row mb-4">
            <div class="col-md-3 fw-bold">
                Issue Date
            </div>

            <div class="col-md-9">
                @Model.IssueDate.ToString("dd MMM yyyy")
            </div>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
                Delete
            </a>

        </div>

    </div>

</div>