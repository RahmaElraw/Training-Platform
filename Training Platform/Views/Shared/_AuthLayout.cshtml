<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Training Platform</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <style>
            html, body {
                height: 100%;
                margin: 0;
                overflow: hidden;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                background-color: #f4f7fb;
                display: flex;
                flex-direction: column;
            }

            .auth-header {
                background: linear-gradient(135deg, #4b6cff 0%, #2f3fb8 100%);
                color: #fff;
                padding: 18px 20px 45px;
                text-align: center;
                position: relative;
                overflow: hidden;
                flex-shrink: 0;
            }

                .auth-header::before {
                    content: "";
                    position: absolute;
                    width: 180px;
                    height: 180px;
                    background: rgba(255,255,255,0.08);
                    border-radius: 50%;
                    top: -80px;
                    right: -50px;
                }

                .auth-header::after {
                    content: "";
                    position: absolute;
                    width: 120px;
                    height: 120px;
                    background: rgba(255,255,255,0.08);
                    border-radius: 50%;
                    bottom: -60px;
                    left: -30px;
                }

                .auth-header h2 {
                    position: relative;
                    z-index: 1;
                    font-size: 1.4rem;
                }

                .auth-header p {
                    position: relative;
                    z-index: 1;
                    font-size: 0.85rem;
                }

            .auth-body {
                flex: 1;
                display: flex;
                justify-content: center;
                align-items: flex-start;
                padding: 0 20px;
                min-height: 0;
            }

            .auth-card {
                width: 100%;
                max-width: 600px;
                background: #fff;
                border-radius: 14px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.08);
                padding: 20px 32px;
                margin-top: -30px;
                position: relative;
                z-index: 2;
                overflow-y: auto;
                max-height: 100%;
            }

            .form-label {
                margin-bottom: 3px;
                font-size: 0.85rem;
            }

            .form-control {
                border-radius: 8px;
                padding: 7px 12px;
                border: 1px solid #dfe3ec;
                font-size: 0.9rem;
            }

                .form-control:focus {
                    border-color: #4b6cff;
                    box-shadow: 0 0 0 0.2rem rgba(75, 108, 255, 0.15);
                }

            .mb-3 {
                margin-bottom: 0.75rem !important;
            }

            .mb-4 {
                margin-bottom: 0.9rem !important;
            }

            .btn-primary {
                background-color: #4b6cff;
                border: none;
                border-radius: 8px;
                padding: 9px;
                font-weight: 600;
            }

                .btn-primary:hover {
                    background-color: #3a56db;
                }

            .input-icon {
                position: relative;
            }

                .input-icon i {
                    position: absolute;
                    top: 50%;
                    transform: translateY(-50%);
                    left: 12px;
                    font-size: 0.85rem;
                    color: #9aa3b5;
                }

                .input-icon .form-control {
                    padding-left: 36px;
                }

            @@media (max-height: 700px) {
                .auth-header {
                    padding: 12px 20px 30px;
                }

                .auth-card {
                    padding: 16px 28px;
                }
            }
    </style>
</head>
<body>

    <div class="auth-header">
        <h2 class="fw-bold mb-1"><i class="bi bi-mortarboard-fill me-2"></i>Training Platform</h2>
        <p class="opacity-75 mb-0">Grow your skills with our courses and expert trainers.</p>
    </div>

    <div class="auth-body">
        <div class="auth-card">
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>