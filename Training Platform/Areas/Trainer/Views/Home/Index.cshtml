@model Training_Platform.Areas.Trainer.ViewModels.TrainerHomeVM

@{
    ViewData["Title"] = "Trainer Dashboard";
    Layout = "~/Areas/Trainer/Views/Shared/_TrainerLayout.cshtml";
}

<div class="container-fluid">

    <!-- ========================================= -->
    <!-- Welcome -->
    <!-- ========================================= -->

    <div class="row mb-4">

        <div class="col">

            <h3 class="mb-1">
                Trainer Dashboard
            </h3>

            <p class="text-muted mb-0">
                Welcome back! Here's an overview of your training activities.
            </p>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- Statistics Cards -->
    <!-- ========================================= -->

    <div class="row g-3 mb-4">


        <!-- My Courses -->

        <div class="col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                My Courses
                            </h6>

                            <h3 class="mb-0">
                                @Model.MyCourses
                            </h3>

                        </div>

                        <div class="avatar avatar-xl">

                            <div class="avatar-name rounded-circle bg-primary">

                                <span>
                                    <i class="fas fa-book text-white"></i>
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Published Courses -->

        <div class="col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                Published Courses
                            </h6>

                            <h3 class="mb-0">
                                @Model.PublishedCourses
                            </h3>

                        </div>

                        <div class="avatar avatar-xl">

                            <div class="avatar-name rounded-circle bg-success">

                                <span>
                                    <i class="fas fa-check-circle text-white"></i>
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Trainees -->

        <div class="col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                Total Trainees
                            </h6>

                            <h3 class="mb-0">
                                @Model.TotalTrainees
                            </h3>

                        </div>

                        <div class="avatar avatar-xl">

                            <div class="avatar-name rounded-circle bg-info">

                                <span>
                                    <i class="fas fa-users text-white"></i>
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Quizzes -->

        <div class="col-sm-6 col-xl-3">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <h6 class="text-muted mb-2">
                                My Quizzes
                            </h6>

                            <h3 class="mb-0">
                                @Model.MyQuizzes
                            </h3>

                        </div>

                        <div class="avatar avatar-xl">

                            <div class="avatar-name rounded-circle bg-warning">

                                <span>
                                    <i class="fas fa-question-circle text-white"></i>
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- Charts -->
    <!-- ========================================= -->

    <div class="row g-4 mb-4">


        <!-- Trainee Progress -->

        <div class="col-lg-5">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">
                        Trainee Progress
                    </h5>

                    <small class="text-muted">
                        Course completion overview
                    </small>

                </div>

                <div class="card-body">

                    <div id="progressChart"
                         style="height: 300px;">
                    </div>

                </div>

            </div>

        </div>


        <!-- Trainees Per Course -->

        <div class="col-lg-7">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-header bg-transparent">

                    <h5 class="mb-0">
                        Trainees per Course
                    </h5>

                    <small class="text-muted">
                        Number of trainees enrolled in your courses
                    </small>

                </div>

                <div class="card-body">

                    <div id="courseChart"
                         style="height: 300px;">
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- Additional Statistics -->
    <!-- ========================================= -->

    <div class="row g-4 mb-4">


        <!-- Completion -->

        <div class="col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center">

                    <div class="mb-3">

                        <i class="fas fa-graduation-cap fa-3x text-primary"></i>

                    </div>

                    <h6 class="text-muted">
                        Completed Enrollments
                    </h6>

                    <h2 class="mb-0">
                        @Model.CompletedEnrollments
                    </h2>

                </div>

            </div>

        </div>


        <!-- In Progress -->

        <div class="col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center">

                    <div class="mb-3">

                        <i class="fas fa-spinner fa-3x text-warning"></i>

                    </div>

                    <h6 class="text-muted">
                        In Progress
                    </h6>

                    <h2 class="mb-0">
                        @Model.InProgressEnrollments
                    </h2>

                </div>

            </div>

        </div>


        <!-- Certificates -->

        <div class="col-lg-4">

            <div class="card h-100 shadow-sm border-0">

                <div class="card-body text-center">

                    <div class="mb-3">

                        <i class="fas fa-certificate fa-3x text-success"></i>

                    </div>

                    <h6 class="text-muted">
                        Certificates Issued
                    </h6>

                    <h2 class="mb-0">
                        @Model.CertificatesIssued
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- Recent Courses -->
    <!-- ========================================= -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-transparent">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-1">
                        My Recent Courses
                    </h5>

                    <p class="text-muted mb-0">
                        Your latest created courses.
                    </p>

                </div>

                <a asp-area="Trainer"
                   asp-controller="Courses"
                   asp-action="Index"
                   class="btn btn-primary btn-sm">

                    <i class="fas fa-book me-1"></i>

                    View All Courses

                </a>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.RecentCourses.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0 align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Trainees
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Created
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var course in Model.RecentCourses)
                            {
                                <tr>

                                    <td>

                                        <span class="fw-semibold">
                                            @course.Title
                                        </span>

                                    </td>


                                    <td>

                                        <span>

                                            <i class="fas fa-users me-1 text-muted"></i>

                                            @course.TraineesCount

                                        </span>

                                    </td>


                                    <td>

                                        @if (course.IsPublished)
                                        {
                                            <span class="badge bg-success">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Draft
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <span class="text-muted">

                                            @course.CreatedAt.ToString("dd MMM yyyy")

                                        </span>

                                    </td>


                                    <td>

                                        <a asp-area="Trainer"
                                           asp-controller="Courses"
                                           asp-action="Details"
                                           asp-route-id="@course.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="fas fa-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="fas fa-book-open fa-3x text-muted mb-3"></i>

                    <h5>
                        No Courses Yet
                    </h5>

                    <p class="text-muted">
                        You haven't created any courses yet.
                    </p>

                    <a asp-area="Trainer"
                       asp-controller="Courses"
                       asp-action="Create"
                       class="btn btn-primary">

                        <i class="fas fa-plus me-1"></i>

                        Create Course

                    </a>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        document.addEventListener("DOMContentLoaded", function() {

            // =========================================
            // Trainee Progress Chart
            // =========================================

            var progressElement =
                document.getElementById('progressChart');

            if (progressElement) {

                var progressChart =
                    echarts.init(progressElement);

                var progressOption = {

                    tooltip: {
                        trigger: 'item'
                    },

                    legend: {
                        bottom: '0'
                    },

                    series: [

                        {
                            name: 'Trainees',

                            type: 'pie',

                            radius: ['45%', '70%'],

                            avoidLabelOverlap: false,

                            label: {
                                show: false
                            },

                            data: [

                                {
                                    value: @Model.CompletedEnrollments,
                                    name: 'Completed'
                                },

                                {
                                    value: @Model.InProgressEnrollments,
                                    name: 'In Progress'
                                }

                            ]

                        }

                    ]

                };

                progressChart.setOption(progressOption);


                window.addEventListener('resize', function() {
                    progressChart.resize();
                });

            }


            // =========================================
            // Trainees Per Course Chart
            // =========================================

            var courseElement =
                document.getElementById('courseChart');

            if (courseElement) {

                var courseChart =
                    echarts.init(courseElement);


                var courseNames = [

                            @foreach (var course in Model.CourseStatistics)
                    {
                        @: '@Html.Raw(
                                        course.CourseTitle
                                                .Replace("\\", "\\\\")
                                                .Replace("'", "\\'")
                                                .Replace("\r", "")
                                                .Replace("\n", " ")
                            )',
                                }

                ];


                    var traineeCounts = [

                                            @foreach (var course in Model.CourseStatistics)
                        {
                            @: @course.TraineesCount,
                        }

                            ];


                    var courseOption = {

                        tooltip: {
                            trigger: 'axis'
                        },

                        grid: {
                            left: '3%',
                            right: '4%',
                            bottom: '15%',
                            containLabel: true
                        },

                        xAxis: {

                            type: 'category',

                            data: courseNames,

                            axisLabel: {
                                rotate: 25
                            }

                        },

                        yAxis: {

                            type: 'value',

                            minInterval: 1

                        },

                        series: [

                            {
                                name: 'Trainees',

                                type: 'bar',

                                data: traineeCounts,

                                barMaxWidth: 45

                            }

                        ]

                    };


                    courseChart.setOption(courseOption);


                    window.addEventListener('resize', function() {
                        courseChart.resize();
                    });

                }

            });

        </script>
    }