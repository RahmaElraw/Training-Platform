@model Training_Platform.ViewModels.CreateUserVM

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">@Localizer["CreateUser"]</h5>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>

            <div class="mb-3">

                <label class="form-label">
                    @Localizer["ProfileImage"]
                </label>

                <input type="file"
                       name="ProfileImageFile"
                       class="form-control"
                       accept="image/*" />

            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
            </div>

            <div class="form-group">
                <label asp-for="SelectedRole"></label>

                <select asp-for="SelectedRole"
                        asp-items="Model.Roles"
                        class="form-control">

                    <option value="">@Localizer["SelectRole"]</option>

                </select>

                <span asp-validation-for="SelectedRole"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="IsApproved" class="form-check-input" />
                <label asp-for="IsApproved" class="form-check-label">
                    @Localizer["Approved"]
                </label>
            </div>

            <button class="btn btn-primary">
                @Localizer["Create"]
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                @Localizer["Cancel"]
            </a>

        </form>

    </div>

</div>
