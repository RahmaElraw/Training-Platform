@model IEnumerable<Training_Platform.ViewModels.TrainerProgressVM>

@{
    ViewData["Title"] = "Trainee Progress";
    Layout = "~/Areas/Trainer/Views/Shared/_TrainerLayout.cshtml";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col">
            <h3 class="mb-1">Trainee Progress</h3>
            <p class="text-muted mb-0">
                Track the progress of trainees enrolled in your courses.
            </p>
        </div>
    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            <i class="fas fa-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">

            <i class="fas fa-exclamation-circle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm border-0">

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Trainee</th>
                                <th>Email</th>
                                <th>Course</th>
                                <th>Progress</th>
                                <th>Status</th>
                                <th>Certificate</th>
                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- Trainee -->
                                    <td>
                                        <div class="fw-semibold">
                                            @(string.IsNullOrWhiteSpace(item.TraineeName)
                                                ? "Unknown"
                                                : item.TraineeName)
                                        </div>
                                    </td>


                                    <!-- Email -->
                                    <td>
                                        <span class="text-muted">
                                            @(string.IsNullOrWhiteSpace(item.TraineeEmail)
                                                ? "No email"
                                                : item.TraineeEmail)
                                        </span>
                                    </td>


                                    <!-- Course -->
                                    <td>
                                        <span class="fw-semibold">
                                            @item.CourseTitle
                                        </span>
                                    </td>


                                    <!-- Progress -->
                                    <td style="min-width: 200px;">

                                        <div class="d-flex justify-content-between mb-1">

                                            <small class="text-muted">
                                                @item.CompletedLessons /
                                                @item.TotalLessons Lessons
                                            </small>

                                            <small class="fw-semibold">
                                                @item.ProgressPercentage.ToString("0.##")%
                                            </small>

                                        </div>


                                        <div class="progress"
                                             style="height: 8px;">

                                            <div class="progress-bar"
                                                 role="progressbar"
                                                 style="width: @item.ProgressPercentage%;"
                                                 aria-valuenow="@item.ProgressPercentage"
                                                 aria-valuemin="0"
                                                 aria-valuemax="100">
                                            </div>

                                        </div>

                                    </td>


                                    <!-- Status -->
                                    <td>

                                        @if (item.IsCompleted)
                                        {
                                            <span class="badge bg-success">

                                                <i class="fas fa-check me-1"></i>

                                                Completed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fas fa-clock me-1"></i>

                                                In Progress

                                            </span>
                                        }

                                    </td>


                                    <!-- Certificate -->
                                    <td>

                                        @if (item.HasCertificate)
                                        {
                                            <span class="badge bg-success">

                                                <i class="fas fa-certificate me-1"></i>

                                                Generated

                                            </span>

                                            @if (item.CertificateId.HasValue)
                                            {
                                                <div class="small text-muted mt-1">
                                                    Certificate #@item.CertificateId
                                                </div>
                                            }
                                        }
                                        else if (item.IsCompleted)
                                        {
                                            <form asp-area="Trainer"
                                                  asp-controller="Progress"
                                                  asp-action="GenerateCertificate"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="enrollmentId"
                                                       value="@item.EnrollmentId" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-primary"
                                                        onclick="return confirm('Generate certificate for this trainee?');">

                                                    <i class="fas fa-certificate me-1"></i>

                                                    Generate Certificate

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not Available
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <!-- No Trainees -->
        <div class="card shadow-sm border-0">

            <div class="card-body text-center py-5">

                <div class="mb-3">

                    <i class="fas fa-chart-line fa-3x text-muted"></i>

                </div>

                <h5>No Trainee Progress Yet</h5>

                <p class="text-muted mb-0">
                    No trainees have enrolled in your courses yet.
                </p>

            </div>

        </div>
    }

</div>