@model Training_Platform.ViewModels.CertificateWithRelatedVM

@{
    ViewData["Title"] = "Certificates Management";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-dark">
            <i class="fas fa-certificate text-primary me-2"></i>Course Completion Certificates
        </h5>
    </div>

    <div class="card-body">
        <!-- Search Filter -->
        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fas fa-search text-muted"></i></span>
                    <input asp-for="Query"
                           name="query"
                           class="form-control"
                           placeholder="Search by Certificate, User or Course..." />
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    Search
                </button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
                </div>
            }
        </form>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Certificate No.</th>
                        <th>User</th>
                        <th>Course</th>
                        <th>Issue Date</th>
                        <th>Status</th>
                        <th width="200" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Certificates.Any())
                    {
                        @foreach (var item in Model.Certificates)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.CertificateNumber</td>
                                <td>
                                    <div>@(item.User?.UserName ?? "N/A")</div>
                                    <small class="text-muted">@(item.User?.Email ?? "")</small>
                                </td>
                                <td>@(item.Course?.Title ?? "N/A")</td>
                                <td>@item.IssueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.CertificateUrl))
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success">
                                            <i class="fas fa-check-circle me-1"></i> Link Added
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fas fa-clock me-1"></i> Pending Link
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-outline-info"
                                           title="View Details">
                                            <i class="fas fa-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn @(string.IsNullOrWhiteSpace(item.CertificateUrl) ? "btn-warning" : "btn-outline-primary")"
                                           title="Manage Certificate Link">
                                            <i class="fas fa-link me-1"></i>
                                            @(string.IsNullOrWhiteSpace(item.CertificateUrl) ? "Add Link" : "Edit Link")
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="fas fa-folder-open fa-2x mb-2 d-block"></i>
                                No completed course certificates found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-query="@Model.Query">
                                @i
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>