@model Training_Platform.ViewModels.ResetPasswordVM

@{
    ViewData["Title"] = Localizer["ResetPassword"];
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">@Localizer["ResetPassword"]</h2>
    <p class="text-muted mb-0">@Localizer["EnterNewPassword"]</p>
</div>

<form asp-action="ResetPassword" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label">@Localizer["ConfirmPassword"]</label>
        <div class="input-icon">
            <i class="bi bi-lock-fill"></i>
            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>

    <div class="d-grid">
        <input type="submit" value="@Localizer["ResetPassword"]" class="btn btn-primary btn-lg" />
    </div>

    <div class="text-center mt-3">
        <a asp-action="Login" class="text-primary text-decoration-none fw-semibold">@Localizer["BackToLogin"]</a>
    </div>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}