@using Training_Platform.Models
@model Lesson

@{
    ViewData["Title"] = "Lesson Details";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Lesson Details
            </h2>

            <p class="text-muted mb-0">
                View lesson information
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                <i class="bi bi-pencil"></i>
                Edit

            </a>

            <a asp-action="Index"
               asp-route-courseId="@Model.CourseId"
               class="btn btn-outline-secondary">

                Back to Lessons

            </a>

        </div>

    </div>


    <!-- Lesson Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Lesson Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-8">

                    <h4 class="fw-bold">
                        @Model.Title
                    </h4>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="text-muted">
                            @Model.Description
                        </p>
                    }
                    else
                    {
                        <p class="text-muted">
                            No description available.
                        </p>
                    }

                </div>

                <div class="col-md-4">

                    <div class="mb-3">

                        <strong>
                            Course:
                        </strong>

                        <div>
                            @(Model.Course?.Title ?? "N/A")
                        </div>

                    </div>

                    <div>

                        <strong>
                            Order:
                        </strong>

                        <div class="mt-1">

                            <span class="badge bg-secondary">
                                @Model.OrderNumber
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Video -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Lesson Video
            </h5>

        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.VideoUrl))
            {
                <a href="@Model.VideoUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-outline-primary">

                    <i class="bi bi-play-circle"></i>
                    Open Video

                </a>

                <div class="mt-3">

                    <small class="text-muted">
                        Video URL
                    </small>

                    <div class="text-break">
                        @Model.VideoUrl
                    </div>

                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No video available.
                </p>
            }

        </div>

    </div>


    <!-- Course Materials -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0">
                        Course Materials
                    </h5>

                    <small class="text-muted">
                        Learning materials for this lesson
                    </small>

                </div>


                <a asp-area="Trainer"
                   asp-controller="Materials"
                   asp-action="Index"
                   asp-route-lessonId="@Model.Id"
                   class="btn btn-sm btn-primary">

                    <i class="bi bi-folder2-open me-1"></i>
                    Manage Materials

                </a>

            </div>

        </div>


        <div class="card-body">

            @if (Model.CourseMaterials != null &&
                 Model.CourseMaterials.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>Title</th>

                                <th>Link</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int materialCounter = 1;
                            }

                            @foreach (var material in Model.CourseMaterials)
                            {
                                <tr>

                                    <td>
                                        @materialCounter
                                    </td>

                                    <td>

                                        <strong>
                                            @material.Title
                                        </strong>

                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(material.Url))
                                        {
                                            <a href="@material.Url"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-box-arrow-up-right me-1"></i>
                                                Open

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No URL
                                            </span>
                                        }

                                    </td>

                                </tr>

                                materialCounter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-file-earmark-x fs-2 text-muted"></i>

                    <p class="text-muted mt-2 mb-3">
                        No course materials found.
                    </p>

                    <a asp-area="Trainer"
                       asp-controller="Materials"
                       asp-action="Create"
                       asp-route-lessonId="@Model.Id"
                       class="btn btn-sm btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add First Material

                    </a>

                </div>
            }

        </div>

    </div>


    <!-- Learner Progress -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Learner Progress
            </h5>

        </div>

        <div class="card-body">

            @if (Model.UserProgresses != null &&
                 Model.UserProgresses.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>#</th>

                                <th>User ID</th>

                                <th>Status</th>

                                <th>Completed At</th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int progressCounter = 1;
                            }

                            @foreach (var progress in Model.UserProgresses)
                            {
                                <tr>

                                    <td>
                                        @progressCounter
                                    </td>

                                    <td>
                                        @progress.UserId
                                    </td>

                                    <td>

                                        @if (progress.IsCompleted)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Completed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-clock me-1"></i>
                                                In Progress

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (progress.CompletedAt.HasValue)
                                        {
                                            @progress.CompletedAt.Value.ToString(
                                                "dd MMM yyyy, hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not completed
                                            </span>
                                        }

                                    </td>

                                </tr>

                                progressCounter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-4">

                    <i class="bi bi-people fs-2 text-muted"></i>

                    <p class="text-muted mt-2 mb-0">
                        No learner progress available.
                    </p>

                </div>
            }

        </div>

    </div>

</div>