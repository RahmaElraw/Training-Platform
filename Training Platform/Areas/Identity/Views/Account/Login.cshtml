@model Training_Platform.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">Login</h2>
    <p class="text-muted mb-0">Welcome back to Training Platform</p>
</div>

<form asp-action="Login" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="EmailOrUserName" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-person"></i>
            <input asp-for="EmailOrUserName" class="form-control" placeholder="Email or Full Name" />
        </div>
        <span asp-validation-for="EmailOrUserName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-icon">
            <i class="bi bi-lock"></i>
            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
        </div>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="RememberMe" />
            <label class="form-check-label" asp-for="RememberMe"></label>
        </div>
        <a asp-action="ForgetPassword" class="text-primary text-decoration-none" style="font-size: 0.85rem;">Forgot password?</a>
    </div>

    <div class="d-grid">
        <input type="submit" value="Login" class="btn btn-primary btn-lg" />
    </div>

</form>

<div class="divider-with-text my-4">
    <span>or continue with</span>
</div>

<form asp-action="ExternalLogin" method="post">
    <input type="hidden" name="provider" value="Google" />
    <div class="d-grid">
        <button type="submit" class="google-btn">
            <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
                <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.49h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.63z" />
                <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z" />
                <path fill="#FBBC05" d="M3.97 10.72A5.4 5.4 0 0 1 3.68 9c0-.6.1-1.18.29-1.72V4.95H.96A9 9 0 0 0 0 9c0 1.45.35 2.83.96 4.05l3.01-2.33z" />
                <path fill="#EA4335" d="M9 3.58c1.32 0 2.51.45 3.44 1.35l2.59-2.59A8.6 8.6 0 0 0 9 0 9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z" />
            </svg>
            <span>Continue with Google</span>
        </button>
    </div>
</form>

<div class="text-center mt-4">
    <span class="text-muted">Don't have an account?</span>
    <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Register</a>
</div>
<div class="text-center mt-3">
    <a asp-action="ResendEmailConfirmation" class="text-primary text-decoration-none fw-semibold">Resend Confirmation Email</a>
</div>

<style>
    .divider-with-text {
        display: flex;
        align-items: center;
        text-align: center;
        color: #9aa3b5;
        font-size: 0.8rem;
    }

        .divider-with-text::before,
        .divider-with-text::after {
            content: "";
            flex: 1;
            border-bottom: 1px solid #e2e5ec;
        }

        .divider-with-text span {
            padding: 0 12px;
        }

    .google-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 10px;
        background: #fff;
        border: 1px solid #dfe3ec;
        border-radius: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: #3c4043;
        cursor: pointer;
        transition: box-shadow 0.15s ease, background 0.15s ease;
    }

        .google-btn:hover {
            background: #f8f9fa;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
        }

        .google-btn:active {
            background: #f1f3f4;
        }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_NotificationPartial" />
}