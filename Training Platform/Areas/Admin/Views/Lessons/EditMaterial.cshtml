@model Training_Platform.ViewModels.CourseMaterialVM

<div class="card shadow-sm">

    <div class="card-header">

        <h5 class="mb-0">
            <i class="fas fa-edit me-1"></i>
            Edit Course Material
        </h5>

    </div>


    <div class="card-body">

        <form asp-action="EditMaterial"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   asp-for="LessonId" />


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- Title -->

            <div class="mb-3">

                <label asp-for="Title"
                       class="form-label">

                    Material Title
                    <span class="text-danger">*</span>

                </label>

                <input asp-for="Title"
                       class="form-control"
                       maxlength="100"
                       placeholder="Enter material title" />

                <span asp-validation-for="Title"
                      class="text-danger">
                </span>

            </div>


            <!-- URL -->

            <div class="mb-3">

                <label asp-for="Url"
                       class="form-label">

                    Material URL
                    <span class="text-danger">*</span>

                </label>

                <input asp-for="Url"
                       type="url"
                       class="form-control"
                       placeholder="https://example.com" />

                <span asp-validation-for="Url"
                      class="text-danger">
                </span>

            </div>


            <!-- Buttons -->

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    Save Changes

                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.LessonId"
                   class="btn btn-secondary">

                    <i class="fas fa-arrow-left me-1"></i>
                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}