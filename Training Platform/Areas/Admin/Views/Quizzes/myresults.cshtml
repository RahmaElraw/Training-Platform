@model IEnumerable<Training_Platform.ViewModels.QuizResultViewModel>

<h2>@Localizer["MyQuizResults"]</h2>

@if (!Model.Any())
{
    <p>@Localizer["NoQuizResultsYet"]</p>
}
else
{
    <table class="table">

        <thead>
            <tr>
                <th>@Localizer["Quiz"]</th>
                <th>@Localizer["Score"]</th>
                <th>@Localizer["Status"]</th>
                <th>@Localizer["SubmittedAt"]</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var result in Model)
            {
                <tr>
                    <td>
                        @result.QuizTitle
                    </td>

                    <td>
                        @result.Score%
                    </td>

                    <td>
                        @(result.IsPassed ? Localizer["Passed"] : Localizer["Failed"])
                    </td>

                    <td>
                        @result.SubmittedAt
                    </td>
                </tr>
            }

        </tbody>

    </table>
}