@model Training_Platform.ViewModels.EnrollmentVM

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">@Localizer["EditEnrollment"]</h5>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <div class="row">

                <div class="col-md-6 mb-3">

                    <label asp-for="UserId"
                           class="form-label">

                        @Localizer["Trainee"]
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="UserId"
                            asp-items="ViewBag.Users"
                            class="form-select">

                        <option value="">
                            @Localizer["SelectTrainee"]
                        </option>

                    </select>

                    <span asp-validation-for="UserId"
                          class="text-danger">
                    </span>

                </div>


                <div class="col-md-6 mb-3">

                    <label asp-for="CourseId"
                           class="form-label">

                        @Localizer["Course"]
                        <span class="text-danger">*</span>

                    </label>

                    <select asp-for="CourseId"
                            asp-items="ViewBag.Courses"
                            class="form-select">

                        <option value="">
                            @Localizer["SelectCourse"]
                        </option>

                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger">
                    </span>

                </div>

            </div>


            <div class="mb-3">

                <label asp-for="EnrollmentDate"
                       class="form-label">

                    @Localizer["EnrollmentDate"]
                    <span class="text-danger">*</span>

                </label>

                <input asp-for="EnrollmentDate"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="EnrollmentDate"
                      class="text-danger">
                </span>

            </div>


            <div class="form-check mb-3">

                <input asp-for="IsCompleted"
                       class="form-check-input" />

                <label asp-for="IsCompleted"
                       class="form-check-label">

                    @Localizer["Completed"]

                </label>

            </div>


            <div class="d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fas fa-save me-1"></i>
                    @Localizer["SaveChanges"]

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    @Localizer["Cancel"]

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
