@model Training_Platform.Models.ApplicationUser

@{
    ViewData["Title"] = Localizer["UserDetails"];
}

<div class="card">

    <div class="card-header">
        <h5 class="mb-0">@Localizer["UserDetails"]</h5>
    </div>

    <div class="card-body">

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                @Localizer["UserName"]
            </div>

            <div class="col-md-9">
                @Model.UserName
            </div>

        </div>

        <hr />

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                @Localizer["Email"]
            </div>

            <div class="col-md-9">
                @Model.Email
            </div>

        </div>

        <hr />

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                @Localizer["PhoneNumber"]
            </div>

            <div class="col-md-9">
                @(string.IsNullOrEmpty(Model.PhoneNumber) ? Localizer["NotProvided"].Value : Model.PhoneNumber)
            </div>

        </div>

        <hr />

        <div class="row mb-3">

            <div class="col-md-3 fw-bold">
                @Localizer["Status"]
            </div>

            <div class="col-md-9">

                @if (Model.IsApproved)
                {
                    <span class="badge bg-success">
                        @Localizer["Approved"]
                    </span>
                }
                else
                {
                    <span class="badge bg-danger">
                        @Localizer["Pending"]
                    </span>
                }

            </div>

        </div>

        <hr />

        <div class="row mb-4">

            <div class="col-md-3 fw-bold">
                @Localizer["CreatedAt"]
            </div>

            <div class="col-md-9">
                @Model.CreatedAt.ToString("dd MMM yyyy")
            </div>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                @Localizer["Edit"]

            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">

                @Localizer["Delete"]

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                @Localizer["Back"]

            </a>

        </div>

    </div>

</div>
