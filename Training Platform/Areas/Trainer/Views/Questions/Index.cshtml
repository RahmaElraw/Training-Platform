@using Training_Platform.Models
@model IEnumerable<Question>

@{
    ViewData["Title"] = Localizer["Questions"].Value;

    var quiz = ViewBag.Quiz as Quiz;
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">@Localizer["Questions"]</h2>
            <p class="text-muted mb-0">
                @Localizer["ManageQuestionsFor"]
                <strong>@(quiz?.Title ?? Localizer["Quiz"].Value)</strong>
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Quizzes"
               asp-action="Details"
               asp-route-id="@quiz?.Id"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> @Localizer["BackToQuiz"]
            </a>

            <a asp-action="Create"
               asp-route-quizId="@quiz?.Id"
               class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> @Localizer["AddQuestion"]
            </a>
        </div>
    </div>

    <!-- Questions Table -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                @Localizer["QuizQuestions"]
            </h5>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>@Localizer["Question"]</th>
                                <th>@Localizer["Type"]</th>
                                <th>@Localizer["Mark"]</th>
                                <th class="text-end">@Localizer["Actions"]</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int counter = 1;
                            }

                            @foreach (var question in Model)
                            {
                                <tr>

                                    <td>
                                        @counter
                                    </td>

                                    <td>
                                        <strong>
                                            @question.QuestionText
                                        </strong>
                                    </td>

                                    <td>
                                        @if (question.QuestionType == QuestionType.MultipleChoice)
                                        {
                                            <span class="badge bg-primary">
                                                @Localizer["MultipleChoice"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">
                                                @Localizer["TrueFalse"]
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @question.Mark
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <div class="d-flex justify-content-end gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-info">
                                                <i class="bi bi-eye"></i>
                                                @Localizer["Details"]
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@question.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-pencil"></i>
                                                @Localizer["Edit"]
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@question.Id"
                                                  asp-route-quizId="@quiz?.Id"
                                                  method="post"
                                                  onsubmit="return confirm('@Localizer["DeleteQuestionConfirm"]');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-trash"></i>
                                                    @Localizer["Delete"]
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                                counter++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-question-circle fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        @Localizer["NoQuestionsFound"]
                    </h5>

                    <p class="text-muted">
                        @Localizer["StartAddingQuestion"]
                    </p>

                    <a asp-action="Create"
                       asp-route-quizId="@quiz?.Id"
                       class="btn btn-primary">
                        <i class="bi bi-plus-lg"></i>
                        @Localizer["AddQuestion"]
                    </a>

                </div>
            }

        </div>

    </div>

</div>