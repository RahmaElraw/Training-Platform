@using System.Text.Json
@model Training_Platform.ViewModels.TrainerHomeVM

@{
    ViewData["Title"] = "Trainer Dashboard";

    var progressData = JsonSerializer.Serialize(new
    {
        completed = Model.CompletedEnrollments,
        inProgress = Model.InProgressEnrollments
    });

    var courseStatistics = JsonSerializer.Serialize(
        Model.CourseStatistics.Select(c => new
        {
            title = c.CourseTitle,
            trainees = c.TraineesCount
        })
    );
}

<div class="trainer-dashboard">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="dashboard-header mb-4">

        <div>
            <span class="dashboard-label">
                TRAINER PANEL
            </span>

            <h2 class="dashboard-title">
                Welcome back, Trainer 👋
            </h2>

            <p class="dashboard-subtitle">
                Here's an overview of your courses and trainees.
            </p>
        </div>

        <div class="header-date">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>

    </div>


    <!-- =========================================================
         STATISTICS
         2 CARDS PER ROW
    ========================================================== -->

    <div class="row g-4 mb-4">

        <!-- My Courses -->
        <div class="col-xl-6 col-lg-6 col-md-6">

            <div class="stat-card">

                <div class="stat-icon courses-icon">
                    <i class="bi bi-book"></i>
                </div>

                <div class="stat-content">

                    <span>
                        My Courses
                    </span>

                    <h3>
                        @Model.MyCourses
                    </h3>

                    <small>
                        <i class="bi bi-collection me-1"></i>
                        Courses assigned to you
                    </small>

                </div>

            </div>

        </div>


        <!-- Published Courses -->
        <div class="col-xl-6 col-lg-6 col-md-6">

            <div class="stat-card">

                <div class="stat-icon published-icon">
                    <i class="bi bi-check-circle"></i>
                </div>

                <div class="stat-content">

                    <span>
                        Published Courses
                    </span>

                    <h3>
                        @Model.PublishedCourses
                    </h3>

                    <small>
                        <i class="bi bi-globe2 me-1"></i>
                        Available courses
                    </small>

                </div>

            </div>

        </div>


        <!-- Total Trainees -->
        <div class="col-xl-6 col-lg-6 col-md-6">

            <div class="stat-card">

                <div class="stat-icon trainees-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div class="stat-content">

                    <span>
                        Total Trainees
                    </span>

                    <h3>
                        @Model.TotalTrainees
                    </h3>

                    <small>
                        <i class="bi bi-person-check me-1"></i>
                        Enrolled trainees
                    </small>

                </div>

            </div>

        </div>


        <!-- My Quizzes -->
        <div class="col-xl-6 col-lg-6 col-md-6">

            <div class="stat-card">

                <div class="stat-icon quizzes-icon">
                    <i class="bi bi-clipboard-check"></i>
                </div>

                <div class="stat-content">

                    <span>
                        My Quizzes
                    </span>

                    <h3>
                        @Model.MyQuizzes
                    </h3>

                    <small>
                        <i class="bi bi-question-circle me-1"></i>
                        Created quizzes
                    </small>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         QUICK ACTIONS + PROGRESS
    ========================================================== -->

    <div class="row g-4 mb-4">

        <!-- Quick Actions -->
        <div class="col-lg-8">

            <div class="dashboard-card">

                <div class="card-heading">

                    <div>
                        <h5>
                            Quick Actions
                        </h5>

                        <p>
                            Quick access to your trainer tools.
                        </p>
                    </div>

                    <i class="bi bi-lightning-charge"></i>

                </div>


                <div class="quick-actions">

                    <!-- Courses -->

                    <a asp-area="Trainer"
                       asp-controller="Courses"
                       asp-action="Index"
                       class="quick-action">

                        <div class="action-icon blue">
                            <i class="bi bi-book"></i>
                        </div>

                        <div class="action-text">

                            <strong>
                                My Courses
                            </strong>

                            <span>
                                View your courses
                            </span>

                        </div>

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <!-- Quizzes -->

                    <a asp-area="Trainer"
                       asp-controller="Quizzes"
                       asp-action="Index"
                       class="quick-action">

                        <div class="action-icon purple">
                            <i class="bi bi-clipboard-check"></i>
                        </div>

                        <div class="action-text">

                            <strong>
                                My Quizzes
                            </strong>

                            <span>
                                Manage your quizzes
                            </span>

                        </div>

                        <i class="bi bi-arrow-right"></i>

                    </a>


                    <!-- Progress -->

                    <a asp-area="Trainer"
                       asp-controller="Progress"
                       asp-action="Index"
                       class="quick-action">

                        <div class="action-icon green">
                            <i class="bi bi-bar-chart"></i>
                        </div>

                        <div class="action-text">

                            <strong>
                                Trainee Progress
                            </strong>

                            <span>
                                Track trainee progress
                            </span>

                        </div>

                        <i class="bi bi-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>


        <!-- Progress Summary -->

        <div class="col-lg-4">

            <div class="dashboard-card progress-summary">

                <div class="card-heading">

                    <div>
                        <h5>
                            Enrollment Progress
                        </h5>

                        <p>
                            Overall trainee progress
                        </p>
                    </div>

                    <i class="bi bi-pie-chart"></i>

                </div>


                <div id="progressChart"></div>


                <div class="progress-legend">

                    <div>

                        <span class="legend-dot completed"></span>

                        <span>
                            Completed
                        </span>

                        <strong>
                            @Model.CompletedEnrollments
                        </strong>

                    </div>


                    <div>

                        <span class="legend-dot progress"></span>

                        <span>
                            In Progress
                        </span>

                        <strong>
                            @Model.InProgressEnrollments
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         COURSE STATISTICS
    ========================================================== -->

    <div class="row g-4 mb-4">

        <div class="col-12">

            <div class="dashboard-card">

                <div class="card-heading">

                    <div>

                        <h5>
                            Trainees per Course
                        </h5>

                        <p>
                            Number of trainees enrolled in each course.
                        </p>

                    </div>

                    <i class="bi bi-bar-chart-line"></i>

                </div>


                <div id="courseChart"></div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         EXTRA STATISTICS
    ========================================================== -->

    <div class="row g-4 mb-4">

        <!-- Completed -->

        <div class="col-md-4">

            <div class="mini-stat completed-stat">

                <div>

                    <span>
                        Completed Enrollments
                    </span>

                    <h3>
                        @Model.CompletedEnrollments
                    </h3>

                </div>

                <i class="bi bi-check2-circle"></i>

            </div>

        </div>


        <!-- In Progress -->

        <div class="col-md-4">

            <div class="mini-stat progress-stat">

                <div>

                    <span>
                        In Progress
                    </span>

                    <h3>
                        @Model.InProgressEnrollments
                    </h3>

                </div>

                <i class="bi bi-hourglass-split"></i>

            </div>

        </div>


        <!-- Certificates -->

        <div class="col-md-4">

            <div class="mini-stat certificate-stat">

                <div>

                    <span>
                        Certificates Issued
                    </span>

                    <h3>
                        @Model.CertificatesIssued
                    </h3>

                </div>

                <i class="bi bi-award"></i>

            </div>

        </div>

    </div>


    <!-- =========================================================
         RECENT COURSES
    ========================================================== -->

    <div class="dashboard-card">

        <div class="card-heading">

            <div>

                <h5>
                    Recent Courses
                </h5>

                <p>
                    Your recently created courses.
                </p>

            </div>


            <a asp-area="Trainer"
               asp-controller="Courses"
               asp-action="Index"
               class="view-all">

                View All

                <i class="bi bi-arrow-right ms-1"></i>

            </a>

        </div>


        @if (Model.RecentCourses != null &&
             Model.RecentCourses.Any())
        {

            <div class="table-responsive">

                <table class="table dashboard-table align-middle">

                    <thead>

                        <tr>

                            <th>
                                Course
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Trainees
                            </th>

                            <th>
                                Created
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var course in Model.RecentCourses)
                        {

                            <tr>

                                <td>

                                    <div class="course-name">

                                        <div class="course-mini-icon">

                                            <i class="bi bi-book"></i>

                                        </div>

                                        <span>
                                            @course.Title
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    @if (course.IsPublished)
                                    {

                                        <span class="status-badge published">

                                            <span></span>

                                            Published

                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge draft">

                                            <span></span>

                                            Draft

                                        </span>

                                    }

                                </td>


                                <td>

                                    <strong>
                                        @course.TraineesCount
                                    </strong>

                                </td>


                                <td>

                                    <span class="created-date">
                                        @course.CreatedAt.ToString("dd MMM yyyy")
                                    </span>

                                </td>


                                <td class="text-end">

                                    <a asp-area="Trainer"
                                       asp-controller="Courses"
                                       asp-action="Details"
                                       asp-route-id="@course.Id"
                                       class="btn btn-sm btn-outline-primary action-button"
                                       title="View Course">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>

                        }

                    </tbody>

                </table>

            </div>

        }
        else
        {

            <div class="empty-state">

                <div class="empty-icon">

                    <i class="bi bi-book"></i>

                </div>

                <h5>
                    No Courses Yet
                </h5>

                <p>
                    You don't have any courses assigned to you yet.
                </p>

                <a asp-area="Trainer"
                   asp-controller="Courses"
                   asp-action="Index"
                   class="btn btn-primary">

                    <i class="bi bi-arrow-right me-1"></i>

                    Go to Courses

                </a>

            </div>

        }

    </div>

</div>


<!-- =============================================================
     ECHARTS
============================================================= -->

<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>


<script>

    document.addEventListener("DOMContentLoaded", function() {

        const progressData =
                @Html.Raw(progressData);

        const courseData =
                @Html.Raw(courseStatistics);


        /* =========================================================
           CHECK DARK MODE
        ========================================================= */

        function isDarkMode() {

            return document.body.classList.contains("dark-mode")
                || document.body.classList.contains("dark")
                || document.body.getAttribute("data-theme") === "dark"
                || document.documentElement.classList.contains("dark-mode")
                || document.documentElement.classList.contains("dark")
                || document.documentElement.getAttribute("data-theme") === "dark";

        }


        function getTextColor() {

            return isDarkMode()
                ? "#e5e7eb"
                : "#1e293b";

        }


        function getMutedColor() {

            return isDarkMode()
                ? "#94a3b8"
                : "#64748b";

        }


        /* =========================================================
           PROGRESS CHART
        ========================================================= */

        const progressElement =
            document.getElementById("progressChart");

        let progressChart = null;


        if (progressElement) {

            progressChart =
                echarts.init(progressElement);


            function renderProgressChart() {

                const dark =
                    isDarkMode();


                progressChart.setOption({

                    backgroundColor: "transparent",

                    tooltip: {
                        trigger: "item"
                    },

                    legend: {
                        show: false
                    },

                    series: [

                        {
                            name: "Enrollment",

                            type: "pie",

                            radius: [
                                "58%",
                                "80%"
                            ],

                            avoidLabelOverlap: false,

                            itemStyle: {

                                borderRadius: 8,

                                borderColor:
                                    dark
                                        ? "#121821"
                                        : "#ffffff",

                                borderWidth: 4

                            },

                            label: {

                                show: true,

                                position: "center",

                                formatter: function() {

                                    const total =
                                        progressData.completed +
                                        progressData.inProgress;

                                    return total +
                                        "\nEnrollments";

                                },

                                fontSize: 18,

                                fontWeight: 700,

                                lineHeight: 28,

                                color:
                                    getTextColor()

                            },

                            labelLine: {
                                show: false
                            },

                            data: [

                                {
                                    value:
                                        progressData.completed,

                                    name:
                                        "Completed",

                                    itemStyle: {
                                        color: "#22c55e"
                                    }
                                },

                                {
                                    value:
                                        progressData.inProgress,

                                    name:
                                        "In Progress",

                                    itemStyle: {
                                        color: "#3b82f6"
                                    }
                                }

                            ]

                        }

                    ]

                });

            }


            renderProgressChart();

        }


        /* =========================================================
           COURSE BAR CHART
        ========================================================= */

        const courseElement =
            document.getElementById("courseChart");

        let courseChart = null;


        if (courseElement) {

            courseChart =
                echarts.init(courseElement);


            function renderCourseChart() {

                const dark =
                    isDarkMode();


                courseChart.setOption({

                    backgroundColor: "transparent",

                    tooltip: {

                        trigger: "axis",

                        axisPointer: {
                            type: "shadow"
                        }

                    },

                    grid: {

                        left: "3%",

                        right: "4%",

                        bottom: "10%",

                        top: "8%",

                        containLabel: true

                    },

                    xAxis: {

                        type: "category",

                        data:
                            courseData.map(
                                item => item.title
                            ),

                        axisLabel: {

                            interval: 0,

                            rotate:
                                courseData.length > 5
                                    ? 25
                                    : 0,

                            color:
                                getMutedColor()

                        },

                        axisLine: {

                            lineStyle: {

                                color:
                                    dark
                                        ? "#334155"
                                        : "#e2e8f0"

                            }

                        }

                    },

                    yAxis: {

                        type: "value",

                        minInterval: 1,

                        axisLabel: {

                            color:
                                getMutedColor()

                        },

                        splitLine: {

                            lineStyle: {

                                color:
                                    dark
                                        ? "#1e293b"
                                        : "#e2e8f0"

                            }

                        },

                        axisLine: {

                            lineStyle: {

                                color:
                                    dark
                                        ? "#334155"
                                        : "#e2e8f0"

                            }

                        }

                    },

                    series: [

                        {

                            name: "Trainees",

                            type: "bar",

                            data:
                                courseData.map(
                                    item => item.trainees
                                ),

                            barWidth: "45%",

                            itemStyle: {

                                color: "#3b82f6",

                                borderRadius: [
                                    6,
                                    6,
                                    0,
                                    0
                                ]

                            }

                        }

                    ]

                });

            }


            renderCourseChart();

        }


        /* =========================================================
           RESIZE
        ========================================================= */

        window.addEventListener(
            "resize",
            function() {

                if (progressChart) {
                    progressChart.resize();
                }

                if (courseChart) {
                    courseChart.resize();
                }

            }
        );


        /* =========================================================
           WATCH THEME CHANGES
        ========================================================= */

        const observer =
            new MutationObserver(function() {

                if (progressChart) {

                    progressChart.resize();

                    progressChart.setOption({

                        series: [
                            {
                                label: {
                                    color:
                                        getTextColor()
                                },

                                itemStyle: {

                                    borderColor:
                                        isDarkMode()
                                            ? "#121821"
                                            : "#ffffff"

                                }

                            }
                        ]

                    });

                }


                if (courseChart) {

                    courseChart.resize();

                }

            });


        observer.observe(
            document.body,
            {
                attributes: true,
                attributeFilter: [
                    "class",
                    "data-theme"
                ]
            }
        );


        observer.observe(
            document.documentElement,
            {
                attributes: true,
                attributeFilter: [
                    "class",
                    "data-theme"
                ]
            }
        );

    });

</script>


<style>

    /* =========================================================
           LIGHT MODE VARIABLES
        ========================================================= */

    .trainer-dashboard {
        --bg: #ffffff;
        --card: #ffffff;
        --card-hover: #f8fafc;
        --text: #0f172a;
        --text-secondary: #475569;
        --muted: #64748b;
        --border: #e2e8f0;
        --border-light: #edf2f7;
        --table-head: #f8fafc;
        --shadow: rgba(15, 23, 42, .06);
        --shadow-hover: rgba(15, 23, 42, .12);
        padding: 10px 5px 40px;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        transition: background .3s ease, color .3s ease;
    }


    /* =========================================================
           DARK MODE
        ========================================================= */

    body.dark-mode .trainer-dashboard,
    body.dark .trainer-dashboard,
    body[data-theme="dark"] .trainer-dashboard,
    html.dark-mode .trainer-dashboard,
    html.dark .trainer-dashboard,
    html[data-theme="dark"] .trainer-dashboard {
        --bg: #090d13;
        --card: #121821;
        --card-hover: #18212d;
        --text: #f1f5f9;
        --text-secondary: #cbd5e1;
        --muted: #94a3b8;
        --border: #263241;
        --border-light: #202b38;
        --table-head: #18212d;
        --shadow: rgba(0, 0, 0, .25);
        --shadow-hover: rgba(0, 0, 0, .4);
    }


    /* =========================================================
           HEADER
        ========================================================= */

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 28px 30px;
        background: linear-gradient( 135deg, #0f172a, #1e3a8a );
        border-radius: 18px;
        color: #ffffff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, .15);
    }


    .dashboard-label {
        font-size: 11px;
        letter-spacing: 2px;
        font-weight: 700;
        opacity: .7;
    }


    .dashboard-title {
        margin: 6px 0 5px;
        font-weight: 700;
    }


    .dashboard-subtitle {
        margin: 0;
        opacity: .75;
    }


    .header-date {
        padding: 10px 16px;
        background: rgba(255,255,255,.1);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 10px;
        font-size: 14px;
    }


    /* =========================================================
           STAT CARDS
           2 x 2
        ========================================================= */

    .stat-card {
        width: 100%;
        min-height: 130px;
        display: flex;
        align-items: center;
        gap: 20px;
        background: var(--card);
        padding: 22px 26px;
        border-radius: 16px;
        border: 1px solid var(--border);
        box-shadow: 0 6px 20px var(--shadow);
        transition: transform .25s ease, box-shadow .25s ease, background .3s ease, border-color .3s ease;
    }


        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 30px var(--shadow-hover);
        }


    .stat-icon {
        flex-shrink: 0;
        width: 62px;
        height: 62px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }


    .courses-icon {
        background: #e8f1ff;
        color: #2563eb;
    }


    .published-icon {
        background: #e9f9f0;
        color: #16a34a;
    }


    .trainees-icon {
        background: #f3eaff;
        color: #7c3aed;
    }


    .quizzes-icon {
        background: #fff3df;
        color: #ea580c;
    }


    .stat-content {
        min-width: 0;
    }


        .stat-content span {
            display: block;
            color: var(--muted);
            font-size: 13px;
            font-weight: 500;
        }


        .stat-content h3 {
            margin: 4px 0;
            font-size: 30px;
            font-weight: 750;
            color: var(--text);
        }


        .stat-content small {
            color: var(--muted);
            font-size: 11px;
        }


    /* =========================================================
           DASHBOARD CARD
        ========================================================= */

    .dashboard-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 6px 20px var(--shadow);
        transition: background .3s ease, border-color .3s ease;
    }


    .card-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }


        .card-heading h5 {
            margin: 0;
            color: var(--text);
            font-weight: 700;
        }


        .card-heading p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 13px;
        }


        .card-heading > i {
            color: #3b82f6;
            font-size: 22px;
        }


    /* =========================================================
           QUICK ACTIONS
        ========================================================= */

    .quick-actions {
        display: grid;
        gap: 10px;
    }


    .quick-action {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border-radius: 12px;
        text-decoration: none;
        border: 1px solid var(--border-light);
        background: transparent;
        transition: .2s ease;
    }


        .quick-action:hover {
            background: var(--card-hover);
            transform: translateX(4px);
        }


        .quick-action .action-text {
            flex: 1;
        }


        .quick-action strong {
            display: block;
            color: var(--text);
            font-size: 14px;
        }


        .quick-action span {
            display: block;
            color: var(--muted);
            font-size: 12px;
            margin-top: 2px;
        }


        .quick-action > i {
            color: var(--muted);
        }


    .action-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        flex-shrink: 0;
    }


        .action-icon.blue {
            background: #e8f1ff;
            color: #2563eb;
        }


        .action-icon.purple {
            background: #f3eaff;
            color: #7c3aed;
        }


        .action-icon.green {
            background: #e9f9f0;
            color: #16a34a;
        }


    /* =========================================================
           PROGRESS CHART
        ========================================================= */

    #progressChart {
        height: 220px;
        width: 100%;
    }


    .progress-legend {
        display: grid;
        gap: 10px;
    }


        .progress-legend > div {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: var(--muted);
        }


        .progress-legend strong {
            margin-left: auto;
            color: var(--text);
        }


    .legend-dot {
